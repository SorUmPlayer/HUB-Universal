--[[
    Blue Lock Rivels Hub – Definitivo + Controle de Bola
    - Aimbot + Reach (Magnet) + ESP
    - Aba Controle de Bola com Botão Flutuante (ON/OFF)
    - Câmera em 3ª pessoa focada na bola (BallAnims) seguindo o olhar
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or bola
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            hitbox = (hb and hb:IsA("BasePart")) and hb or bola
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)

for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end

atualizarReferenciaBola()

-- Função específica para resgatar a parte física da BallAnims ou Hitbox
local function getBallPart()
    local football = workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then return ballAnims end
            if ballAnims:FindFirstChildWhichIsA("BasePart") then return ballAnims:FindFirstChildWhichIsA("BasePart") end
        end
        local hb = football:FindFirstChild("Hitbox")
        if hb and hb:IsA("BasePart") then return hb end
        if football:IsA("BasePart") then return football end
    end
    return hitbox or bola
end

-- =====================================================
--  POSSE DA BOLA
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local velocidadeBola = 65
local controlBallActive = false
local controlBallConnection = nil
local floatingButtonGui = nil

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  SISTEMA DO BOTÃO FLUTUANTE (TOGGLE CONTÍNUO)
-- =====================================================
local function desligarControleBola(btn)
    controlBallActive = false
    if btn then
        btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69) -- Vermelho
        btn.Text = "Control BALL [OFF]"
    end
    if controlBallConnection then
        controlBallConnection:Disconnect()
        controlBallConnection = nil
    end
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function criarBotaoFlutuante()
    if floatingButtonGui then return end

    local gui = Instance.new("ScreenGui")
    gui.Name = "ControlBallGui"
    gui.ResetOnSpawn = false

    local parentObj = (gethui and gethui()) or (syn and syn.protect_gui and (syn.protect_gui(gui), game:GetService("CoreGui"))) or game:GetService("CoreGui")
    gui.Parent = parentObj

    local btn = Instance.new("TextButton")
    btn.Name = "BtnToggleControl"
    btn.Size = UDim2.new(0, 170, 0, 45)
    btn.Position = UDim2.new(0.8, 0, 0.2, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69) -- Vermelho por padrão
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "Control BALL [OFF]"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Active = true
    btn.Draggable = true
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1.5
    stroke.Parent = btn

    btn.MouseButton1Click:Connect(function()
        controlBallActive = not controlBallActive

        if controlBallActive then
            btn.BackgroundColor3 = Color3.fromRGB(40, 167, 69) -- Verde
            btn.Text = "Control BALL [ON]"

            if controlBallConnection then controlBallConnection:Disconnect() end
            controlBallConnection = runService.Heartbeat:Connect(function()
                local ballPart = getBallPart()
                if ballPart then
                    camera.CameraSubject = ballPart
                    ballPart.AssemblyLinearVelocity = camera.CFrame.LookVector * velocidadeBola
                else
                    if player.Character and player.Character:FindFirstChild("Humanoid") then
                        camera.CameraSubject = player.Character.Humanoid
                    end
                end
            end)
        else
            desligarControleBola(btn)
        end
    end)

    floatingButtonGui = gui
end

local function removerBotaoFlutuante()
    desligarControleBola(nil)
    if floatingButtonGui then
        floatingButtonGui:Destroy()
        floatingButtonGui = nil
    end
end

-- =====================================================
--  RESET DA HITBOX (a cada 0.3s)
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem or euTenhoBola() or not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if not aimbotCamera or euTenhoBola() or not bolaValida or not hitbox then return end
    if controlBallActive then return end -- Não conflita com o ControlBALL

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then return end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
end)

