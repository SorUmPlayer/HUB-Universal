--[[
    Blue Lock Rivels – Aimbot simplificado (com debug)
]]

local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")

-- =====================================================
--  DETECÇÃO DA BOLA
-- =====================================================
local function getBall()
    local football = workspace:FindFirstChild("Football")
    if football then return football end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            return obj
        end
    end
    return nil
end

local function getHitbox()
    local ball = getBall()
    if ball then
        if ball.Name == "Hitbox" then return ball end
        local hitbox = ball:FindFirstChild("Hitbox")
        if hitbox and hitbox:IsA("BasePart") then return hitbox end
        return ball
    end
    return nil
end

-- =====================================================
--  VERIFICA SE VOCÊ TEM A BOLA (via BallAnims)
-- =====================================================
local function euTenhoBola()
    local folder = workspace:FindFirstChild(player.Name)
    if folder then
        local football = folder:FindFirstChild("Football")
        if football then
            return football:FindFirstChild("BallAnims") ~= nil
        end
    end
    return false
end

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local gyro = nil
local aimbotAtivo = false

local function ativarAimbot(estado)
    aimbotAtivo = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbot()
    if not aimbotAtivo then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    -- Se você tem a bola, desativa
    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hitbox = getHitbox()
    if not hitbox then
        print("Hitbox não encontrada")
        return
    end

    -- Cria o gyro se não existir
    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 500
        gyro.P = 5000
        gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
        print("BodyGyro criado")
    end

    -- Calcula direção
    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- Loop
runService.Heartbeat:Connect(atualizarAimbot)

