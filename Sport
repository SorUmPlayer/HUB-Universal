-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = bola
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end
atualizarReferenciaBola()

-- =====================================================
--  POSSE (Workspace)
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local aimbotPersonagem_old = false
local aimbotCamera_old = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil
local cameraSmooth = 0.15
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  CONTROLE DE BOLA
-- =====================================================
local controlBallAtivo = false
local controlBallVelocidade = 20
local controlBallButton = nil
local cameraPosicaoOriginal = nil

-- =====================================================
--  FUNÇÃO PARA CONTROLAR A BOLA
-- =====================================================
local function controlarBola()
    if not controlBallAtivo then return end
    if not bolaValida or not hitbox then return end

    -- Pega a direção da câmera
    local camDir = camera.CFrame.LookVector
    local camPos = camera.CFrame.Position

    -- Aplica força/velocidade na bola baseado na direção da câmera
    local velocidade = controlBallVelocidade
    local novaVelocidade = camDir * velocidade

    -- Aplica na bola (se for uma parte física)
    if hitbox:IsA("BasePart") and hitbox:IsA("PVInstance") then
        hitbox.AssemblyLinearVelocity = novaVelocidade
    else
        -- Fallback: move a bola suavemente
        local novaPos = hitbox.Position + camDir * velocidade * 0.1
        hitbox.CFrame = CFrame.new(novaPos)
    end

    -- Mantém a câmera atrás da bola
    local posBola = hitbox.Position
    local distCamera = 10 -- distância da câmera atrás da bola
    local novaPosCam = posBola - camDir * distCamera + Vector3.new(0, 3, 0) -- um pouco acima
    camera.CFrame = CFrame.new(novaPosCam, posBola)
end

-- =====================================================
--  LOOP DO CONTROLE DE BOLA
-- =====================================================
runService.Heartbeat:Connect(function()
    if controlBallAtivo then
        controlarBola()
    end
end)

-- =====================================================
--  TOGGLE DO CONTROLE DE BOLA
-- =====================================================
local function toggleControlBall(estado)
    controlBallAtivo = estado

    if estado then
        -- Salva estado atual dos aimbots
        aimbotPersonagem_old = aimbotPersonagem
        aimbotCamera_old = aimbotCamera

        -- Desativa aimbots
        if aimbotPersonagem then
            ativarAimbotPersonagem(false)
        end
        if aimbotCamera then
            aimbotCamera = false
        end

        -- Muda cor do botão para verde
        if controlBallButton then
            controlBallButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            controlBallButton.Text = "Control Ball v1 [ON]"
        end

        print("Controle de Bola ATIVADO")
    else
        -- Restaura aimbots
        if aimbotPersonagem_old then
            ativarAimbotPersonagem(true)
        end
        if aimbotCamera_old then
            aimbotCamera = true
        end

        -- Muda cor do botão para vermelho
        if controlBallButton then
            controlBallButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            controlBallButton.Text = "Control Ball v1 [OFF]"
        end

        print("Controle de Bola DESATIVADO")
    end
end

-- =====================================================
--  CRIAR BOTÃO FLUTUANTE
-- =====================================================
local function criarBotaoFlutuante()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGUI"
    screenGui.Parent = player.PlayerGui

    local frame = Instance.new("Frame")
    frame.Name = "ControlBallButton"
    frame.Parent = screenGui
    frame.Size = UDim2.new(0, 150, 0, 40)
    frame.Position = UDim2.new(0.5, -75, 0.1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.ZIndex = 10
    frame.Active = true
    frame.Draggable = true

    -- Arredondamento
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local text = Instance.new("TextLabel")
    text.Name = "Label"
    text.Parent = frame
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "Control Ball v1 [OFF]"
    text.TextColor3 = Color3.fromRGB(255, 255, 255)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.ZIndex = 11

    -- Clique para alternar
    local function onClick()
        toggleControlBall(not controlBallAtivo)
    end

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            onClick()
        end
    end)

    controlBallButton = frame
    return frame
end

-- =====================================================
--  RESTAURA HITBOX
-- =====================================================
local function restaurarHitbox()
    if hitbox then
        hitbox.Size = hitboxOriginalSize
        hitbox.Transparency = hitboxOriginalTransparency
    end
end

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem or controlBallAtivo then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if not aimbotCamera or controlBallAtivo then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH
-- =====================================================
local reachAplicado = false

task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() or controlBallAtivo then
                if hitbox.Size ~= hitboxOriginalSize then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
end)

