-- =============================================
-- FUNÇÕES PARA ENCONTRAR A BOLA E HITBOX
-- =============================================

local function getBallAndHitbox()
    local football = workspace:FindFirstChild("Football")
    if football then
        local hitbox = football:FindFirstChild("Hitbox")
        if hitbox and hitbox:IsA("BasePart") then
            return football, hitbox
        end
        return football, football
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            local hitbox = obj:FindFirstChild("Hitbox")
            if hitbox and hitbox:IsA("BasePart") then
                return obj, hitbox
            end
            return obj, obj
        end
    end
    return nil, nil
end

local function getHitbox()
    local _, hitbox = getBallAndHitbox()
    return hitbox
end

local function getBallPart()
    local ball, _ = getBallAndHitbox()
    return ball
end

local function isBallOccupied()
    local hitbox = getHitbox()
    if not hitbox then return false end
    local parent = hitbox.Parent
    if parent and parent:FindFirstChild("Humanoid") and parent.Name ~= player.Name then
        return true
    end
    if hitbox:IsDescendantOf(workspace:FindFirstChild("AI")) then
        return true
    end
    return false
end

-- =============================================
-- AIMBOT (dois modos)
-- =============================================

local aimbotConnection = nil
local hasBallValue = nil

local function applyAimbot()
    local character = player.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not rootPart or not humanoid then return end

    local ball = getBallPart()
    if not ball then return end

    -- Se o jogador está com a bola, não mira
    if hasBallValue and hasBallValue.Value == true then
        return
    end

    -- Direção para a bola (mantém a altura do chão para o personagem)
    local targetPos = Vector3.new(ball.Position.X, rootPart.Position.Y, ball.Position.Z)
    local direction = (targetPos - rootPart.Position).Unit
    if direction.Magnitude < 0.1 then return end

    if _ENV.AimbotMode == "Personagem" then
        -- Rotaciona o personagem
        rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + direction)
    elseif _ENV.AimbotMode == "Câmera" then
        -- Rotaciona a câmera para olhar para a bola (mantém distância e altura atuais)
        local currentPos = camera.CFrame.Position
        local lookAt = ball.Position
        -- Mantém a mesma altura da câmera para não oscilar
        lookAt = Vector3.new(lookAt.X, currentPos.Y, lookAt.Z)
        camera.CFrame = CFrame.new(currentPos, lookAt)
    end
end

local function startAimbot()
    if aimbotConnection then return end
    aimbotConnection = runService.RenderStepped:Connect(applyAimbot)
end

local function stopAimbot()
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end
end

local function setupHasBall()
    local model = workspace:FindFirstChild(player.Name)
    if model then
        local values = model:FindFirstChild("Values")
        if values then
            hasBallValue = values:FindFirstChild("HasBall")
        end
    end
    if not hasBallValue then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v.Name == "HasBall" and v:IsA("BoolValue") and v.Parent and v.Parent.Name == player.Name then
                hasBallValue = v
                break
            end
        end
    end
    if hasBallValue then
        hasBallValue:GetPropertyChangedSignal("Value"):Connect(function()
            if hasBallValue.Value then
                print("Aimbot pausado: você pegou a bola.")
                if _ENV.AutoLockBall then stopAimbot() end
            else
                print("Aimbot ativado: você perdeu a bola.")
                if _ENV.AutoLockBall then startAimbot() end
            end
        end)
    else
        warn("HasBall não encontrado. O aimbot pode não funcionar corretamente.")
    end
end

-- =============================================
-- REACH (aumentar a hitbox da bola)
-- =============================================

local reachLoop = nil

local function applyReach()
    local hitbox = getHitbox()
    if not hitbox then return end

    if _ENV.MagnetAtivo then
        local range = _ENV.MagnetRange
        hitbox.Size = Vector3.new(range, range, range)
        hitbox.CanCollide = false
    else
        hitbox.Size = Vector3.new(1.4, 1.4, 1.4)
        hitbox.CanCollide = true
    end
end

local function startReachLoop()
    if reachLoop then return end
    reachLoop = task.spawn(function()
        while _ENV.MagnetAtivo do
            applyReach()
            task.wait(0.1)
        end
        applyReach()
    end)
end

local function stopReachLoop()
    _ENV.MagnetAtivo = false
    if reachLoop then
        task.cancel(reachLoop)
        reachLoop = nil
    end
    applyReach()
end

-- =============================================
-- ESP (esfera ao redor da hitbox da bola)
-- =============================================

local espSphere = nil

local function updateESP()
    local hitbox = getHitbox()
    if not hitbox then
        if espSphere then espSphere:Destroy() espSphere = nil end
        return
    end

    if _ENV.ShowESP then
        if not espSphere or espSphere.Parent == nil then
            espSphere = Instance.new("SelectionSphere")
            espSphere.Name = "ReachVisual"
            espSphere.Color3 = Color3.fromRGB(0, 255, 100)
            espSphere.Transparency = 0.7
            espSphere.Adornee = hitbox
            espSphere.Parent = hitbox
        end
        espSphere.Size = hitbox.Size
    else
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end
end

local espLoop = nil
local function startESPLoop()
    if espLoop then return end
    espLoop = task.spawn(function()
        while _ENV.ShowESP do
            updateESP()
            task.wait(0.3)
        end
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end)
end

local function stopESPLoop()
    _ENV.ShowESP = false
    if espLoop then
        task.cancel(espLoop)
        espLoop = nil
    end
    if espSphere then
        espSphere:Destroy()
        espSphere = nil
    end
end

-- =============================================
-- INFINITE STAMINA
-- =============================================

local staminaLoop = nil
local function startStamina()
    if staminaLoop then return end
    staminaLoop = task.spawn(function()
        while true do
            local stats = player:FindFirstChild("PlayerStats")
            if stats then
                local stamina = stats:FindFirstChild("Stamina")
                if stamina then
                    stamina.Value = 100
                end
            end
            task.wait(0.5)
        end
    end)
end

-- =============================================
-- SCORE GOAL
-- =============================================

local selectedOption = nil
local originalPosition = nil

local function storeOriginalPosition()
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then originalPosition = root.Position end
    end
end

local function teleportTo(pos)
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = CFrame.new(pos)
        end
    end
end

local function fireShoot(targetPos)
    local args = { [1] = 110, [4] = targetPos }
    local shootEvent = replicatedStorage:FindFirstChild("Packages") and 
                       replicatedStorage.Packages:FindFirstChild("Knit") and
                       replicatedStorage.Packages.Knit:FindFirstChild("Services") and
                       replicatedStorage.Packages.Knit.Services:FindFirstChild("BallService") and
                       replicatedStorage.Packages.Knit.Services.BallService:FindFirstChild("RE") and
                       replicatedStorage.Packages.Knit.Services.BallService.RE:FindFirstChild("Shoot")
    if shootEvent then
        shootEvent:FireServer(unpack(args))
    else
        warn("Evento de chute não encontrado.")
    end
end

