-- Auto Lock Ball
SectionMain:Toggle({
    Title = "Auto Lock Ball",
    Desc = "Look At Ball Automatically",
    Callback = function(Value)
        _ENV.AutoLockBall = Value

        if _ENV.AutoLockBall then
            local model = game.Workspace:FindFirstChild(player.Name)
            local valuesFolder = model and model:FindFirstChild("Values")
            hasBall = valuesFolder and valuesFolder:FindFirstChild("HasBall")

            if hasBall then
                hasBall:GetPropertyChangedSignal("Value"):Connect(onHasBallChanged)
                connection = runService.RenderStepped:Connect(updateView)
                onHasBallChanged()
            else
                warn("Valor 'HasBall' não encontrado. Verifique se o jogo usa essa estrutura.")
                -- Fallback: tenta encontrar em outro lugar
                for _, child in ipairs(workspace:GetDescendants()) do
                    if child.Name == "HasBall" and child:IsA("BoolValue") then
                        hasBall = child
                        hasBall:GetPropertyChangedSignal("Value"):Connect(onHasBallChanged)
                        connection = runService.RenderStepped:Connect(updateView)
                        onHasBallChanged()
                        break
                    end
                end
            end
        else
            if connection then
                connection:Disconnect()
                connection = nil
            end
        end
    end
})

