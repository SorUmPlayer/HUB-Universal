-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = bola
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end
atualizarReferenciaBola()

-- =====================================================
--  POSSE (Workspace)
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false
local mostrarBotao = true
local controlBallActive = false

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil
local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  RESET DA HITBOX (a cada 0.3s)
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if controlBallActive then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end
    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end
    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if controlBallActive then return end
    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then return end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  CONTROLE DE BOLA – VOO LIVRE (APENAS A BOLA)
-- =====================================================
local function controlarBola()
    if not controlBallActive then return end
    if not bolaValida or not hitbox then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Se a bola estiver muito longe, puxa para perto
    local dist = (hrp.Position - hitbox.Position).Magnitude
    if dist > reachDistancia * 1.5 then
        local direcao = (hrp.Position - hitbox.Position).Unit
        hitbox.CFrame = CFrame.new(hrp.Position - direcao * 3)
        return
    end

    -- Direção da câmera (para onde o jogador está olhando)
    local camLook = camera.CFrame.LookVector
    local camPos = camera.CFrame.Position

    -- A bola será posicionada na direção do olhar, a uma distância fixa do jogador
    local distanciaBola = 5
    local posAlvo = hrp.Position + camLook * distanciaBola

    -- Ajusta a altura da bola com base no olhar da câmera (para cima/baixo)
    -- Calcula o ângulo vertical da câmera
    local verticalAngle = math.asin(math.clamp(camLook.Y, -1, 1))
    -- A altura da bola varia entre -2 e +4 em relação ao peito do jogador
    local alturaOffset = math.sin(verticalAngle) * 4
    posAlvo = Vector3.new(posAlvo.X, hrp.Position.Y + 1.5 + alturaOffset, posAlvo.Z)

    -- Move a bola suavemente para a posição alvo
    hitbox.CFrame = CFrame.new(posAlvo)

    -- Posiciona a câmera atrás da bola (para ver a bola e o campo)
    local camOffset = -camLook * 8 + Vector3.new(0, 3, 0)
    local novaPosCam = posAlvo + camOffset
    camera.CFrame = CFrame.new(novaPosCam, posAlvo)
end

-- =====================================================
--  REACH
-- =====================================================
local reachAplicado = false
local function aplicarReach()
    if euTenhoBola() or not reachAtivo then
        if reachAplicado then
            if hitbox then
                hitbox.Size = hitboxOriginalSize
                hitbox.Transparency = hitboxOriginalTransparency
            end
            reachAplicado = false
        end
        return
    end

    if not hitbox then return end
    local novoSize = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        hitbox.Transparency = 1
        reachAplicado = true
    else
        reachAplicado = true
    end
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarReach()
    atualizarESP()
    if controlBallActive then
        controlarBola()
    end
end)

-- =====================================================
--  BOTÃO FLUTUANTE
-- =====================================================
local controlBallGUI = nil
local controlBallButton = nil

local function criarBotaoFlutuante()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGUI"
    screenGui.Parent = player.PlayerGui
    screenGui.ResetOnSpawn = false
    controlBallGUI = screenGui

    local button = Instance.new("TextButton")
    button.Name = "ControlBallButton"
    button.Size = UDim2.new(0, 120, 0, 40)
    button.Position = UDim2.new(0.85, 0, 0.5, 0)
    button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    button.BackgroundTransparency = 0.2
    button.Text = "Control Ball v2"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 0
    button.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.Image = "rbxassetid://13160458777"
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.8
    shadow.BackgroundTransparency = 1
    shadow.Size = UDim2.new(1, 12, 1, 12)
    shadow.Position = UDim2.new(0, -6, 0, -6)
    shadow.ZIndex = 0
    shadow.Parent = button

    local function atualizarCorBotao(ativo)
        if ativo then
            button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            button.Text = "Control Ball v2 ✅"
        else
            button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            button.Text = "Control Ball v2 ❌"
        end
    end

    button.MouseButton1Click:Connect(function()
        controlBallActive = not controlBallActive
        atualizarCorBotao(controlBallActive)

        local status = controlBallActive and "ATIVADO" or "DESATIVADO"
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Controle de Bola",
            Text = "Controle de Bola " .. status .. "!",
            Duration = 2
        })

        if controlBallActive then
            if gyro then
                gyro:Destroy()
                gyro = nil
            end
        end
    end)

    -- Arrastar
    local dragging = false
    local dragStartPos = nil
    local buttonStartPos = nil

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStartPos = input.Position
            buttonStartPos = button.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    userInput.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStartPos
            local newPos = UDim2.new(
                buttonStartPos.X.Scale,
                buttonStartPos.X.Offset + delta.X,
                buttonStartPos.Y.Scale,
                buttonStartPos.Y.Offset + delta.Y
            )
            newPos = UDim2.new(
                math.clamp(newPos.X.Scale, 0, 1),
                math.clamp(newPos.X.Offset, 0, 500),
                math.clamp(newPos.Y.Scale, 0, 1),
                math.clamp(newPos.Y.Offset, 0, 500)
            )
            button.Position = newPos
        end
    end)

    atualizarCorBotao(false)
    controlBallButton = button
    return button
end

criarBotaoFlutuante()

