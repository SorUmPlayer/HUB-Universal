--[[
    Blue Lock Rivels Hub – Refeito do zero
    Aimbot Personagem + Câmera | Reach com ESP na bola
    Desativa aimbot quando pega a bola
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")
local userInput = game:GetService("UserInputService")

-- =====================================================
--  DETECÇÃO DA BOLA (adaptável)
-- =====================================================
local function getBall()
    -- Primeiro, tenta o caminho direto
    local football = workspace:FindFirstChild("Football")
    if football then return football end

    -- Fallback: procura por qualquer parte com nome contendo "ball"
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            return obj
        end
    end
    return nil
end

local function getHitbox()
    local ball = getBall()
    if ball then
        -- Se já for a hitbox (ex: Football.Hitbox)
        if ball.Name == "Hitbox" then return ball end
        -- Procura filho chamado Hitbox
        local hitbox = ball:FindFirstChild("Hitbox")
        if hitbox and hitbox:IsA("BasePart") then
            return hitbox
        end
        -- Se não achar, usa a própria bola como hitbox
        return ball
    end
    return nil
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil          -- para o aimbot personagem
local cameraLerp = 0.2    -- suavidade da câmera
local ultimoChute = 0
local selectedTeam = nil
local hasBall = nil
local connection = nil

-- =====================================================
--  VERIFICA SE JOGADOR PEGOU A BOLA
-- =====================================================
local function jogadorTemBola()
    -- Tenta encontrar pelo HasBall
    local model = game.Workspace:FindFirstChild(player.Name)
    if model then
        local values = model:FindFirstChild("Values")
        if values then
            local hasBallValue = values:FindFirstChild("HasBall")
            if hasBallValue and hasBallValue:IsA("BoolValue") then
                return hasBallValue.Value
            end
        end
    end
    
    -- Fallback: verifica se a bola está perto e colidindo
    local hitbox = getHitbox()
    if not hitbox then return false end
    
    local char = player.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- Verifica se a hitbox está dentro do jogador
    local dist = (hrp.Position - hitbox.Position).Magnitude
    return dist < 3
end

-- =====================================================
--  AIMBOT PERSONAGEM (usa BodyGyro)
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if estado then
        -- Cria um BodyGyro no HumanoidRootPart
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 500
        gyro.P = 5000
        gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
        gyro.CFrame = hrp.CFrame
    else
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
    end
end

local function atualizarAimbotPersonagem()
    -- Desativa se jogador tiver a bola
    if jogadorTemBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end
    
    if not aimbotPersonagem then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hitbox = getHitbox()
    if not hitbox then return end

    -- Direção para a hitbox (mantendo altura Y do personagem)
    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    if gyro then
        gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
    end
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    -- Desativa se jogador tiver a bola
    if jogadorTemBola() then
        return
    end
    
    if not aimbotCamera then return end
    local hitbox = getHitbox()
    if not hitbox then return end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    -- Interpolação suave
    local novaPos = posCamera:Lerp(posBola, cameraLerp)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH (aumenta a hitbox da bola)
-- =====================================================
local function aplicarReach()
    local hitbox = getHitbox()
    if not hitbox then return end

    if reachAtivo then
        -- Aumenta o tamanho da hitbox para o alcance definido
        hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
        hitbox.Transparency = 0.5 -- opcional, para ver
    else
        -- Restaura tamanho original (chutei 1.4, ajuste se necessário)
        hitbox.Size = Vector3.new(1.4, 1.4, 1.4)
        hitbox.Transparency = 0
    end
end

-- =====================================================
--  ESP DA ÁREA (na bola)
-- =====================================================
local espSphere = nil

local function atualizarESP()
    local hitbox = getHitbox()
    if not hitbox then
        if espSphere then espSphere:Destroy() espSphere = nil end
        return
    end

    if mostrarESP then
        if not espSphere or espSphere.Parent ~= hitbox then
            espSphere = Instance.new("SelectionSphere")
            espSphere.Name = "ReachESP"
            espSphere.Adornee = hitbox
            espSphere.Parent = hitbox
            espSphere.Color3 = Color3.fromRGB(0, 255, 100)
            espSphere.Transparency = 0.7
        end
        -- Ajusta o tamanho da esfera para o alcance atual
        local scale = reachDistancia / 2  -- SelectionSphere usa Scale, ajuste empírico
        espSphere.Scale = Vector3.new(scale, scale, scale)
    else
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end
end

-- =====================================================
--  LOOP PRINCIPAL (executa a cada frame)
-- =====================================================
runService.RenderStepped:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarReach()
    atualizarESP()
end)

