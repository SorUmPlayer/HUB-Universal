local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")

-- =====================================================
--  DETECÇÃO DA BOLA
-- =====================================================
local function getBall()
    local football = workspace:FindFirstChild("Football")
    if football then return football end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            return obj
        end
    end
    return nil
end

local function getHitbox()
    local ball = getBall()
    if ball then
        if ball.Name == "Hitbox" then return ball end
        local hitbox = ball:FindFirstChild("Hitbox")
        if hitbox and hitbox:IsA("BasePart") then
            return hitbox
        end
        return ball
    end
    return nil
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil
local cameraLerp = 0.15 -- reduzido pra ficar mais suave
local ultimoChute = 0
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- Cache pra evitar ficar procurando toda hora
local hasBallCache = false
local lastCheckTime = 0
local checkInterval = 0.1 -- verifica a cada 0.1 segundos (em vez de todo frame)

-- =====================================================
--  VERIFICA SE JOGADOR PEGOU A BOLA (COM CACHE)
-- =====================================================
local function jogadorTemBola()
    local now = tick()
    
    -- Só verifica a cada 0.1 segundos (menos processamento)
    if now - lastCheckTime < checkInterval then
        return hasBallCache
    end
    lastCheckTime = now
    
    -- Verifica pelo HasBall
    local model = game.Workspace:FindFirstChild(player.Name)
    if model then
        local values = model:FindFirstChild("Values")
        if values then
            local hasBallValue = values:FindFirstChild("HasBall")
            if hasBallValue and hasBallValue:IsA("BoolValue") then
                hasBallCache = hasBallValue.Value
                return hasBallCache
            end
        end
    end
    
    -- Fallback: verifica distância
    local hitbox = getHitbox()
    if not hitbox then 
        hasBallCache = false
        return false
    end
    
    local char = player.Character
    if not char then 
        hasBallCache = false
        return false
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        hasBallCache = false
        return false
    end
    
    local dist = (hrp.Position - hitbox.Position).Magnitude
    hasBallCache = dist < 2.5
    return hasBallCache
end

-- =====================================================
--  RESTAURA HITBOX
-- =====================================================
local function restaurarHitbox()
    local hitbox = getHitbox()
    if hitbox then
        hitbox.Size = hitboxOriginalSize
        hitbox.Transparency = hitboxOriginalTransparency
    end
end

-- =====================================================
--  AIMBOT PERSONAGEM (com recriação inteligente)
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then 
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return 
    end
    
    local temBola = jogadorTemBola()
    
    -- Se tiver bola, remove o gyro
    if temBola then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end
    
    -- Se não tiver bola
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local hitbox = getHitbox()
    if not hitbox then return end

    -- Recria o gyro se necessário
    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 500
        gyro.P = 5000
        gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit

    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA (com verificação de chute)
-- =====================================================
local cameraTarget = nil
local cameraSmooth = 0.15

local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    
    local temBola = jogadorTemBola()
    local hitbox = getHitbox()
    
    -- Se não tem hitbox, não faz nada
    if not hitbox then return end
    
    -- Se tem bola, não segue (mas mantém a câmera onde está)
    if temBola then
        return
    end
    
    -- Verifica se a bola está voando (chute)
    local velocidade = hitbox.AssemblyLinearVelocity.Magnitude
    if velocidade > 50 then
        -- Se a bola foi chutada, não força a câmera pra não bugar
        return
    end
    
    -- Segue a bola suavemente
    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    
    -- Só atualiza se a bola não estiver muito longe
    local dist = (posCamera - posBola).Magnitude
    if dist > 100 then
        -- Se muito longe, não teleporta a câmera
        return
    end
    
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH (com cache)
-- =====================================================
local reachAplicado = false

local function aplicarReach()
    local temBola = jogadorTemBola()
    local hitbox = getHitbox()
    if not hitbox then return end

    -- Se tiver bola OU reach desativado, restaura
    if temBola or not reachAtivo then
        if reachAplicado then
            restaurarHitbox()
            reachAplicado = false
        end
        return
    end

    -- Aplica o reach
    if not reachAplicado or hitbox.Size.X ~= reachDistancia then
        hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
        hitbox.Transparency = 0.5
        reachAplicado = true
    end
end

-- =====================================================
--  ESP (com cache)
-- =====================================================
local espAtivo = false

local function atualizarESP()
    local temBola = jogadorTemBola()
    local hitbox = getHitbox()
    
    -- Se não tiver hitbox ou tiver bola ou ESP desativado
    if not hitbox or temBola or not mostrarESP then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
            espAtivo = false
        end
        return
    end

    -- Cria/atualiza o ESP
    if not espAtivo or espSphere == nil then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 100)
        espSphere.Transparency = 0.7
        espAtivo = true
    end
    
    local scale = reachDistancia / 2
    if espSphere.Scale.X ~= scale then
        espSphere.Scale = Vector3.new(scale, scale, scale)
    end
end

-- =====================================================
--  LOOP PRINCIPAL (com throttle)
-- =====================================================
local function loopPrincipal()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarReach()
    atualizarESP()
end

-- Conecta o loop com throttling (executa menos vezes por segundo)
runService.RenderStepped:Connect(loopPrincipal)

