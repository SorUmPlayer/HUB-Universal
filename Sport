-- ========================================
-- FUNÇÕES DINÂMICAS PARA ENCONTRAR A BOLA
-- ========================================

local function getBallPart()
    -- Procura por qualquer parte que pareça ser a bola principal
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            -- Verifica se tem um filho chamado "Hitbox" (ou similar)
            local hitbox = obj:FindFirstChild("Hitbox")
            if hitbox and hitbox:IsA("BasePart") then
                return obj, hitbox
            end
            -- Se não tiver Hitbox, pode ser que a própria parte seja a hitbox
            -- Então retornamos ela como hitbox também
            return obj, obj
        end
    end
    -- Fallback: procura no workspace.Football (nome antigo)
    local football = workspace:FindFirstChild("Football")
    if football then
        local hitbox = football:FindFirstChild("Hitbox")
        if hitbox then
            return football, hitbox
        else
            -- Se não tiver hitbox, usamos o próprio football como hitbox
            return football, football
        end
    end
    return nil, nil
end

-- Função que retorna a hitbox atual
local function getBallHitbox()
    local _, hitbox = getBallPart()
    return hitbox
end

-- Verifica se a bola está ocupada por outro jogador (ou IA)
local function bolaOcupada()
    local hitbox = getBallHitbox()
    if not hitbox then return false end
    local pai = hitbox.Parent
    if pai:FindFirstChild("Humanoid") and pai.Name ~= player.Name then
        return true
    end
    if hitbox:IsDescendantOf(workspace:FindFirstChild("AI")) then
        return true
    end
    return false
end

-- ========================================
-- AIMBOT (Auto Lock Ball)
-- ========================================

local connection
local hasBall
local originalPosition
local selectedOption = nil

local function updateView()
    if hasBall and hasBall.Value == false and player.Character then
        local character = player.Character
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChild("Humanoid")
        local ballPart, _ = getBallPart()
        if rootPart and humanoid and ballPart then
            local targetPosition = Vector3.new(ballPart.Position.X, rootPart.Position.Y, ballPart.Position.Z)
            local direction = (targetPosition - rootPart.Position).Unit
            rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + direction)
            camera.CFrame = CFrame.new(
                rootPart.Position - direction * 10 + Vector3.new(0, 5, 0), 
                rootPart.Position
            )
        end
    end
end

local function onHasBallChanged()
    if hasBall.Value then
        print("Aimbot desativado: jogador pegou a bola.")
    else
        print("Aimbot ativado: jogador sem a bola.")
    end
end

-- ========================================
-- MAGNET / REACH (novo método sem firetouchinterest)
-- ========================================

local function aplicarMagnet()
    local hitbox = getBallHitbox()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hitbox or not hrp then return end

    if not bolaOcupada() and (tick() - ultimoChute > 3) then
        -- Se a bola está viajando rápido, não puxamos (evita detecção)
        if hitbox.AssemblyLinearVelocity.Magnitude > 40 then
            ultimoChute = tick()
            return
        end

        local dist = (hrp.Position - hitbox.Position).Magnitude
        if dist <= _ENV.MagnetRange then
            -- Aumentamos a hitbox visualmente (efeito local)
            hitbox.Size = Vector3.new(_ENV.MagnetRange, _ENV.MagnetRange, _ENV.MagnetRange)
            hitbox.CanCollide = false

            -- Método alternativo: mover a hitbox para perto do jogador (simula "alcance")
            -- Isso faz a bola "grudar" no jogador se estiver dentro do alcance
            local direction = (hrp.Position - hitbox.Position).Unit
            local newPos = hrp.Position - direction * 2  -- posiciona na frente do jogador
            hitbox.CFrame = CFrame.new(newPos)
        else
            -- Fora do alcance, restaura o tamanho original
            hitbox.Size = Vector3.new(1.4, 1.4, 1.4)
        end
    else
        hitbox.Size = Vector3.new(1.4, 1.4, 1.4)
    end
end

