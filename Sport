--[[
    Blue Lock Rivels Hub – Com Controle de Bola
    - Botão flutuante "Control Ball v1" (Vermelho/Verde)
    - Desativa aimbot automático quando ativado
    - Controla a bola com a câmera
    - Slider de velocidade da bola
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")
local userInputService = game:GetService("UserInputService")
local players = game:GetService("Players")

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

-- =====================================================
--  ATUALIZA REFERÊNCIA DA BOLA (EVENTOS)
-- =====================================================
local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = bola
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end
atualizarReferenciaBola()

-- =====================================================
--  POSSE – APENAS POR Workspace.SeuNome.Football
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  NOVAS VARIÁVEIS – CONTROLE DE BOLA
-- =====================================================
local controleBolaAtivo = false
local velocidadeBola = 20
local bolaControlavel = false
local botaoFlutuante = nil
local botaoDraggable = nil
local dragging = false
local dragStart = nil
local dragStartPos = nil

-- =====================================================
--  RESET DA HITBOX
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    -- Se o Controle de Bola estiver ativo, NÃO executa aimbot
    if controleBolaAtivo then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    -- Se o Controle de Bola estiver ativo, NÃO executa aimbot da câmera
    if controleBolaAtivo then
        return
    end

    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  CONTROLE DE BOLA – LÓGICA PRINCIPAL
-- =====================================================
local function controlarBola()
    if not controleBolaAtivo then
        -- Se desativado, volta a câmera para o personagem
        if player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                camera.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 5, 0), hrp.Position)
            end
        end
        return
    end

    if not bolaValida or not hitbox then return end

    -- Verifica se o jogador está com a bola (posse)
    local tenhoBola = euTenhoBola()

    if tenhoBola then
        -- Se está com a bola, controla ela com a câmera
        local cameraLookVector = camera.CFrame.LookVector
        local cameraPosition = camera.CFrame.Position

        -- Direção que a câmera está olhando (plano XZ)
        local dirXZ = Vector3.new(cameraLookVector.X, 0, cameraLookVector.Z).Unit

        -- Aplica velocidade na direção da câmera
        local forca = velocidadeBola * 0.5 -- ajuste fino
        hitbox.Velocity = Vector3.new(dirXZ.X * forca, 0, dirXZ.Z * forca)

        -- Faz a bola "flutuar" na frente da câmera (opcional)
        -- hitbox.Position = cameraPosition + cameraLookVector * 5
    end
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  CRIA BOTÃO FLUTUANTE
-- =====================================================
local function criarBotaoFlutuante()
    -- Se já existir, remove
    if botaoFlutuante then
        botaoFlutuante:Destroy()
        botaoFlutuante = nil
    end

    -- Cria a ScreenGui
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGUI"
    screenGui.Parent = player.PlayerGui
    screenGui.ResetOnSpawn = false

    -- Frame principal (botão)
    local frame = Instance.new("ImageButton")
    frame.Name = "ControlBallButton"
    frame.Size = UDim2.new(0, 120, 0, 40)
    frame.Position = UDim2.new(0.5, -60, 0.8, -20) -- posição inicial
    frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho (desligado)
    frame.BackgroundTransparency = 0.2
    frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    frame.BorderSizePixel = 2
    frame.Parent = screenGui

    -- Texto do botão
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "ButtonText"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = "Control Ball v1"
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextScaled = false
    textLabel.Parent = frame

    -- --- DRAG (arrastar) ---
    local dragging = false
    local dragStart = nil
    local dragStartPos = nil

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            dragStartPos = frame.Position
        end
    end)

    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    userInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                dragStartPos.X.Scale,
                dragStartPos.X.Offset + delta.X,
                dragStartPos.Y.Scale,
                dragStartPos.Y.Offset + delta.Y
            )
        end
    end)

    -- --- CLICK (toggle) ---
    frame.MouseButton1Click:Connect(function()
        controleBolaAtivo = not controleBolaAtivo

        if controleBolaAtivo then
            frame.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Verde (ligado)
            textLabel.Text = "Control Ball v1 [ON]"
            -- Desativa aimbots automaticamente
            if aimbotPersonagem then
                ativarAimbotPersonagem(false)
            end
            aimbotCamera = false
        else
            frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho (desligado)
            textLabel.Text = "Control Ball v1"
            -- Reativa aimbots se estavam ligados antes? (opcional)
            -- Vamos deixar o usuário reativar manualmente
        end
    end)

    botaoFlutuante = screenGui
    return screenGui
end

-- =====================================================
--  LOOP PRINCIPAL (com controle de bola)
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
    controlarBola() -- Nova função
end)

