local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")

-- =====================================================
--  DETECÇÃO DA BOLA (mais robusta)
-- =====================================================
local function getBall()
    -- Procura em workspace
    local football = workspace:FindFirstChild("Football")
    if football then return football end

    -- Procura qualquer parte com "ball" no nome
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            return obj
        end
    end
    return nil
end

local function getHitbox()
    local ball = getBall()
    if not ball then return nil end

    -- Se a própria bola for a hitbox (ex: Football é a hitbox)
    if ball.Name == "Hitbox" then return ball end

    -- Procura filho chamado Hitbox
    local hitbox = ball:FindFirstChild("Hitbox")
    if hitbox and hitbox:IsA("BasePart") then return hitbox end

    -- Fallback: usa a própria bola como hitbox
    return ball
end

-- =====================================================
--  POSSE (Workspace + Distância)
-- =====================================================
local function euTenhoBola()
    -- 1) Workspace.SeuNome.Football existe?
    local meuFootball = workspace:FindFirstChild(player.Name)
    if meuFootball and meuFootball:FindFirstChild("Football") then
        return true
    end

    -- 2) Distância da hitbox < 2.5
    local hitbox = getHitbox()
    if hitbox and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            return (hrp.Position - hitbox.Position).Magnitude < 2.5
        end
    end
    return false
end

-- =====================================================
--  VARIÁVEIS
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil
local cameraSmooth = 0.15
local selectedTeam = nil

local espObject = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)

-- =====================================================
--  RESTAURA HITBOX
-- =====================================================
local function restaurarHitbox()
    local hitbox = getHitbox()
    if hitbox then
        hitbox.Size = hitboxOriginalSize
        hitbox.Transparency = 0
    end
end

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hitbox = getHitbox()
    if not hitbox then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 500
        gyro.P = 5000
        gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if euTenhoBola() then return end

    local hitbox = getHitbox()
    if not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 50 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH (MAGNET) – CORRIGIDO
-- =====================================================
local reachAplicado = false

local function aplicarReach()
    -- Se EU estiver com a bola OU Reach desativado, restaura
    if euTenhoBola() or not reachAtivo then
        if reachAplicado then
            restaurarHitbox()
            reachAplicado = false
        end
        return
    end

    local hitbox = getHitbox()
    if not hitbox then
        -- Se não achou hitbox, tenta novamente depois
        return
    end

    -- Força o novo tamanho (mesmo que igual, garante a aplicação)
    local novoSize = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        hitbox.Transparency = 0  -- mantém invisível
        reachAplicado = true
    else
        -- Se o tamanho já estiver correto, apenas marca como aplicado
        reachAplicado = true
    end
end

-- =====================================================
--  ESP (Highlight verde)
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP then
        if espObject then
            espObject:Destroy()
            espObject = nil
        end
        return
    end

    local hitbox = getHitbox()
    if not hitbox then
        if espObject then
            espObject:Destroy()
            espObject = nil
        end
        return
    end

    if not espObject then
        local highlight = Instance.new("Highlight")
        highlight.Name = "ReachESP"
        highlight.Adornee = hitbox
        highlight.FillColor = Color3.fromRGB(0, 255, 100)
        highlight.FillTransparency = 0.7
        highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
        highlight.OutlineTransparency = 0.5
        highlight.Parent = hitbox
        espObject = highlight
    end
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarReach()
    atualizarESP()
end)

