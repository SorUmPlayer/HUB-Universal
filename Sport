--  BOTÃO FLUTUANTE
-- =====================================================
local function criarBotaoFlutuante()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGUI"
    screenGui.Parent = player.PlayerGui

    local button = Instance.new("TextButton")
    button.Name = "ControlBallButton"
    button.Size = UDim2.new(0, 130, 0, 40)
    button.Position = UDim2.new(0.5, -65, 0.85, 0)
    button.Text = "Control Ball v1"
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    button.BorderSizePixel = 0
    button.Parent = screenGui

    -- Arrastável
    local dragging = false
    local dragStart = nil
    local startPos = nil

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
        end
    end)

    button.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            button.Position = UDim2.new(
                startPos.X.Scale + delta.X / screenGui.AbsoluteSize.X,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale + delta.Y / screenGui.AbsoluteSize.Y,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    button.MouseButton1Click:Connect(function()
        local novoEstado = not controlBallActive
        alternarControleBola(novoEstado)

        if novoEstado then
            button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            button.Text = "Control Ball v1 (ON)"
        else
            button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            button.Text = "Control Ball v1"
        end

        if toggleControlBall then
            toggleControlBall:SetValue(novoEstado)
        end
    end)

    return button
end

local botaoFlutuante = criarBotaoFlutuante()

