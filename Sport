-- =====================================================
local ControlTab = Window:Tab({ Title = "Controle de Bola", Icon = "circle" })

local secControl = ControlTab:Section({ Title = "Painel ControlBALL", TextXAlignment = "Left" })

secControl:Toggle({
    Title = "Abrir Botão Flutuante",
