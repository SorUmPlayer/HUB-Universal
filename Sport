--[[
    Blue Lock Rivels Hub – Otimizado para servidores públicos
    - Cache da bola e hitbox por eventos
    - Loop com throttling (executa a cada 2 frames)
    - Aimbot estável mesmo com muitos jogadores
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")

-- =====================================================
--  REFERÊNCIAS DA BOLA (cache)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

-- =====================================================
--  ATUALIZA REFERÊNCIA DA BOLA (chamado por eventos)
-- =====================================================
local function atualizarReferenciaBola()
    -- Procura a bola solta (Workspace.Football)
    local football = workspace:FindFirstChild("Football")
    if football then
        bola = football
        -- Tenta achar hitbox
        local hb = bola:FindFirstChild("Hitbox")
        if hb and hb:IsA("BasePart") then
            hitbox = hb
        else
            hitbox = bola -- usa a própria bola
        end
        bolaValida = true
        return
    end

    -- Procura bola em posse de algum jogador (Workspace.Nome.Football)
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") and child:FindFirstChild("Football") then
            local footballInPlayer = child:FindFirstChild("Football")
            if footballInPlayer then
                bola = footballInPlayer
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        end
    end

    -- Se não achou, invalida
    bola = nil
    hitbox = nil
    bolaValida = false
end

-- =====================================================
--  EVENTOS PARA MANTER CACHE ATUALIZADO
-- =====================================================
workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)
-- Também escuta mudanças nos filhos dos jogadores (quando pegam/soltam a bola)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end

-- Inicializa
atualizarReferenciaBola()

-- =====================================================
--  POSSE (cada frame, mas com cache)
-- =====================================================
local tenhoBolaCache = false
local lastPosseCheck = 0
local posseCheckInterval = 0.2 -- segundos

local function euTenhoBola()
    local now = tick()
    if now - lastPosseCheck < posseCheckInterval then
        return tenhoBolaCache
    end
    lastPosseCheck = now

    -- 1) Workspace.SeuNome.Football existe?
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        tenhoBolaCache = true
        return true
    end

    -- 2) Distância da hitbox < 2.5 (fallback)
    if hitbox and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dist = (hrp.Position - hitbox.Position).Magnitude
            if dist < 2.5 then
                tenhoBolaCache = true
                return true
            end
        end
    end

    tenhoBolaCache = false
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil
local cameraSmooth = 0.15
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- Contador de frames para throttling
local frameCounter = 0
local framesToSkip = 2 -- executa a cada 2 frames

-- =====================================================
--  RESTAURA HITBOX
-- =====================================================
local function restaurarHitbox()
    if hitbox then
        hitbox.Size = hitboxOriginalSize
        hitbox.Transparency = hitboxOriginalTransparency
    end
end

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 500
        gyro.P = 5000
        gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    -- Não força durante chute forte
    if hitbox.AssemblyLinearVelocity.Magnitude > 60 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH
-- =====================================================
local reachAplicado = false

local function aplicarReach()
    if euTenhoBola() or not reachAtivo then
        if reachAplicado then
            restaurarHitbox()
            reachAplicado = false
        end
        return
    end

    if not hitbox then return end

    local novoSize = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        hitbox.Transparency = 1 -- invisível
        reachAplicado = true
    else
        reachAplicado = true
    end
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL COM THROTTLING
-- =====================================================
runService.Heartbeat:Connect(function()
    frameCounter = frameCounter + 1
    if frameCounter % (framesToSkip + 1) ~= 0 then
        -- Pula este frame
        return
    end

    -- Atualiza cache da posse (já tem throttling interno)
    euTenhoBola()

    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarReach()
    atualizarESP()
end)

-- =====================================================
--  UI – WindUI
-- =====================================================
local StarterGui = game:GetService("StarterGui")
StarterGui:SetCore("SendNotification",{
    Title = "Blue Lock Rivels",
    Text = "Otimizado para servidores públicos!",
    Duration = 3
})

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "⚽ Blue Lock Rivels",
    Icon = "rbxassetid://10723343321",
    Author = "Sor_Gostoso",
    Folder = "BlueLockHub",
    Size = UDim2.fromOffset(480, 400),
    Transparent = true,
    Theme = "Dark",
    Resizable = true,
    SideBarWidth = 200,
    HideSearchBar = true,
    ScrollBarEnabled = false,
})

local MainTab = Window:Tab({ Title = "Blue Lock Rivels", Icon = "home" })

-- Seção Aimbot
local secAimbot = MainTab:Section({ Title = "Aimbot", TextXAlignment = "Left" })

secAimbot:Toggle({
    Title = "Aimbot Personagem",
    Desc = "Corpo vira para a bola",
    Callback = function(v)
        ativarAimbotPersonagem(v)
    end
})

secAimbot:Toggle({
    Title = "Aimbot Câmera",
    Desc = "Câmera segue a bola",
    Callback = function(v)
        aimbotCamera = v
    end
})

-- Seção Reach
local secReach = MainTab:Section({ Title = "Reach (Magnet)", TextXAlignment = "Left" })

secReach:Slider({
    Title = "Alcance",
    Desc = "Distância para pegar a bola",
    Step = 1,
    Value = { Min = 1, Max = 40, Default = 20 },
    Callback = function(v)
        reachDistancia = v
        if espSphere then
            local scale = reachDistancia / 2.5
            espSphere.Scale = Vector3.new(scale, scale, scale)
        end
    end
})

secReach:Toggle({
    Title = "Ativar Reach",
    Desc = "Aumenta a hitbox (invisível)",
    Callback = function(v)
        reachAtivo = v
        if not v then
            restaurarHitbox()
            reachAplicado = false
        end
    end
})

secReach:Toggle({
    Title = "Mostrar Área (ESP)",
    Desc = "Círculo verde em volta da bola",
    Callback = function(v)
        mostrarESP = v
        if not v and espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end
})

-- Seção Extras
local secExtras = MainTab:Section({ Title = "Extras", TextXAlignment = "Left" })

secExtras:Button({
    Title = "Infinite Stamina",
    Desc = "Stamina infinita",
    Callback = function()
        task.spawn(function()
            while true do
                local player = game:GetService("Players").LocalPlayer
                if player:FindFirstChild("PlayerStats") and player.PlayerStats:FindFirstChild("Stamina") then
                    player.PlayerStats.Stamina.Value = 100
                end
                task.wait()
            end
        end)
    end
})

secExtras:Dropdown({
    Title = "Time",
    Desc = "Selecione para o gol",
    Options = {"Home", "Away"},
    Callback = function(opt)
        selectedTeam = opt
    end
})

secExtras:Button({
    Title = "Fazer Gol",
    Desc = "Marca um gol",
    Callback = function()
        if not selectedTeam then
            warn("Selecione um time primeiro!")
            return
        end

        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local posOriginal = hrp.Position
        local posGol = selectedTeam == "Home" and Vector3.new(-234, 11, -47) or Vector3.new(311, 11, -50)

        hrp.CFrame = CFrame.new(posGol)
        task.wait(0.2)
        local args = { [1] = 110, [4] = posGol }
        game:GetService("ReplicatedStorage").Packages.Knit.Services.BallService.RE.Shoot:FireServer(unpack(args))
        task.wait(0.2)
        hrp.CFrame = CFrame.new(posOriginal)
    end
})

