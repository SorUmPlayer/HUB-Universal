                    botaoFlutuante.Text = "Control Ball v1 (ON)"
                else
                    botaoFlutuante.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    botaoFlutuante.Text = "Control Ball v1"
                end
            end
        end)
        toggleControlBall = tog
    end

    local function carregarExtras(parent)
        local y = 5
        criarBotao(parent, "Infinite Stamina", y, function()
            task.spawn(function()
                while true do
                    local player = game:GetService("Players").LocalPlayer
                    if player:FindFirstChild("PlayerStats") and player.PlayerStats:FindFirstChild("Stamina") then
                        player.PlayerStats.Stamina.Value = 100
                    end
                    task.wait()
                end
            end)
        end)
        y = y + 40

        criarLabel(parent, "Time para Gol", y)
        y = y + 30

        local homeBtn = Instance.new("TextButton")
        homeBtn.Size = UDim2.new(0, 80, 0, 25)
        homeBtn.Position = UDim2.new(0, 10, 0, y)
        homeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
        homeBtn.BorderSizePixel = 0
        homeBtn.Text = "Home"
        homeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        homeBtn.TextScaled = true
        homeBtn.Font = Enum.Font.GothamBold
        homeBtn.Parent = parent
        homeBtn.MouseButton1Click:Connect(function()
            selectedTeam = "Home"
            homeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            awayBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
        end)

        local awayBtn = Instance.new("TextButton")
        awayBtn.Size = UDim2.new(0, 80, 0, 25)
        awayBtn.Position = UDim2.new(0, 100, 0, y)
        awayBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
        awayBtn.BorderSizePixel = 0
        awayBtn.Text = "Away"
        awayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        awayBtn.TextScaled = true
        awayBtn.Font = Enum.Font.GothamBold
        awayBtn.Parent = parent
        awayBtn.MouseButton1Click:Connect(function()
            selectedTeam = "Away"
            awayBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            homeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
        end)

        y = y + 35
        criarBotao(parent, "Fazer Gol", y, function()
            if not selectedTeam then
                warn("Selecione um time primeiro!")
                return
            end

            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local posOriginal = hrp.Position
            local posGol = selectedTeam == "Home" and Vector3.new(-234, 11, -47) or Vector3.new(311, 11, -50)

            hrp.CFrame = CFrame.new(posGol)
            task.wait(0.2)
            local args = { [1] = 110, [4] = posGol }
            game:GetService("ReplicatedStorage").Packages.Knit.Services.BallService.RE.Shoot:FireServer(unpack(args))
            task.wait(0.2)
            hrp.CFrame = CFrame.new(posOriginal)
        end)
    end

    -- Abrir/fechar com tecla (Insert)
    userInput.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Insert then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)

    return mainFrame
end

criarUI()

