local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")

-- =====================================================
--  DETECÇÃO DA BOLA E HITBOX (SEPARADAS)
-- =====================================================
local bolaVisual = nil
local hitbox = nil
local hitboxCriada = false

local function encontrarBola()
    -- Procura a bola visual (qualquer parte com "ball" no nome)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            bolaVisual = obj
            -- Tenta achar um filho chamado "Hitbox"
            local hb = obj:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                -- Se não tem hitbox, CRIAMOS UMA HITBOX INVISÍVEL
                if not hitboxCriada then
                    hitbox = Instance.new("Part")
                    hitbox.Name = "Hitbox"
                    hitbox.Size = Vector3.new(1.4, 1.4, 1.4)
                    hitbox.Transparency = 1
                    hitbox.CanCollide = false
                    hitbox.Anchored = true
                    hitbox.Parent = obj
                    hitboxCriada = true
                end
                -- Atualiza a posição da hitbox para seguir a bola visual
                if hitbox then
                    hitbox.CFrame = obj.CFrame
                end
            end
            return
        end
    end
    -- Se não achou bola, reseta
    bolaVisual = nil
    hitbox = nil
end

-- Atualiza a posição da hitbox (se criada) a cada frame
local function atualizarPosicaoHitbox()
    if hitbox and hitboxCriada and bolaVisual then
        hitbox.CFrame = bolaVisual.CFrame
    end
end

-- Encontra a bola inicial
encontrarBola()

-- Escuta mudanças no workspace para detectar quando a bola aparece/desaparece
workspace.ChildAdded:Connect(encontrarBola)
workspace.ChildRemoved:Connect(encontrarBola)
-- Também escuta mudanças dentro dos modelos (jogadores)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(encontrarBola)
        child.ChildRemoved:Connect(encontrarBola)
    end
end

-- =====================================================
--  POSSE (Workspace + Distância)
-- =====================================================
local tenhoBolaCache = false
local lastPosseCheck = 0
local posseCheckInterval = 0.2

local function euTenhoBola()
    local now = tick()
    if now - lastPosseCheck < posseCheckInterval then
        return tenhoBolaCache
    end
    lastPosseCheck = now

    -- 1) Workspace.SeuNome.Football existe?
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        tenhoBolaCache = true
        return true
    end

    -- 2) Distância da hitbox < 2.5
    if hitbox and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - hitbox.Position).Magnitude < 2.5 then
            tenhoBolaCache = true
            return true
        end
    end

    tenhoBolaCache = false
    return false
end

-- =====================================================
--  VARIÁVEIS
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil
local cameraSmooth = 0.15
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)

-- =====================================================
--  RESTAURA HITBOX
-- =====================================================
local function restaurarHitbox()
    if hitbox then
        hitbox.Size = hitboxOriginalSize
    end
end

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not hitbox then return end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 500
        gyro.P = 5000
        gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 60 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH (APENAS NA HITBOX, NUNCA NA BOLA VISUAL)
-- =====================================================
local reachAplicado = false

local function aplicarReach()
    if euTenhoBola() or not reachAtivo then
        if reachAplicado then
            restaurarHitbox()
            reachAplicado = false
        end
        return
    end

    if not hitbox then return end

    local novoSize = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        reachAplicado = true
    else
        reachAplicado = true
    end
end

-- =====================================================
--  ESP (CÍRCULO VERDE NA HITBOX)
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL (com throttling)
-- =====================================================
local frameCounter = 0
local framesToSkip = 2

runService.Heartbeat:Connect(function()
    frameCounter = frameCounter + 1
    if frameCounter % (framesToSkip + 1) ~= 0 then
        return
    end

    -- Mantém a hitbox (se criada) na posição da bola visual
    atualizarPosicaoHitbox()

    euTenhoBola()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarReach()
    atualizarESP()
end)

