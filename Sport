})

SectionReach:Slider({
    Title = "Reach Distance",
    Desc = "Alcance máximo seguro (Max 40)",
    Step = 1,
    Value = { Min = 1, Max = 40, Default = 20 },
    Callback = function(value)
        _ENV.MagnetRange = value
    end
})

SectionReach:Toggle({
    Title = "Visual Hitbox Reach",
    Desc = "Aumenta a hitbox localmente (Seguro)",
    Callback = function(state)
        _ENV.MagnetAtivo = state
        
        task.spawn(function()
            while _ENV.MagnetAtivo do
                local hitbox = getBall()
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                
                if hitbox and hrp then
                    if not bolaOcupada() and (tick() - ultimoChute > 3) then
                        if hitbox.AssemblyLinearVelocity.Magnitude > 40 then
                            ultimoChute = tick()
                        else
                            local dist = (hrp.Position - hitbox.Position).Magnitude
                            if dist <= _ENV.MagnetRange then
                                hitbox.Size = Vector3.new(_ENV.MagnetRange, _ENV.MagnetRange, _ENV.MagnetRange)
                                hitbox.CanCollide = false
                                
                                if firetouchinterest then
                                    firetouchinterest(hrp, hitbox, 0)
                                    task.wait()
                                    firetouchinterest(hrp, hitbox, 1)
                                end
                            end
                        end
                    else
                        hitbox.Size = Vector3.new(1.4, 1.4, 1.4)
                    end
                end
                task.wait(0.1)
            end
            
            local hitbox = getBall()
            if hitbox then hitbox.Size = Vector3.new(1.4, 1.4, 1.4) end
        end)
    end
})

SectionReach:Toggle({
    Title = "Mostrar Área (ESP)",
    Desc = "Ver o tamanho da sua zona de alcance",
    Callback = function(state)
        _ENV.ShowESP = state
        task.spawn(function()
            while _ENV.ShowESP do
                local hitbox = getBall()
                if hitbox then
                    local sphere = hitbox:FindFirstChild("ReachVisual") or Instance.new("SelectionSphere")
                    sphere.Name = "ReachVisual"
                    sphere.Adornee = hitbox
                    sphere.Parent = hitbox
                    sphere.Color3 = Color3.fromRGB(0, 255, 100)
                    sphere.Transparency = 0.8
                end
                task.wait(0.5)
            end
            local hitbox = getBall()
            if hitbox and hitbox:FindFirstChild("ReachVisual") then
                hitbox.ReachVisual:Destroy()
            end
        end)
    end
})
