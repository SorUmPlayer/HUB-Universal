local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local target = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                target = football
                local hb = target:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or target
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            target = child
            local hb = target:FindFirstChild("Hitbox")
            hitbox = (hb and hb:IsA("BasePart")) and hb or target
            bolaValida = true
            return
        end
    end
    target = nil
    hitbox = nil
    bolaValida = false
end

Workspace.ChildAdded:Connect(atualizarReferenciaBola)
Workspace.ChildRemoved:Connect(atualizarReferenciaBola)
atualizarReferenciaBola()

-- =====================================================
--  GETBALL (PARA O BOTÃO DE CONTROLE)
-- =====================================================
local function getBall()
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then 
                return ballAnims 
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

-- =====================================================
--  POSSE DA BOLA (via HasBall)
-- =====================================================
local hasBallValue = nil
local hasBallCache = false

local function atualizarHasBall()
    local model = Workspace:FindFirstChild(player.Name)
    if model then
        local values = model:FindFirstChild("Values")
        if values then
            local hb = values:FindFirstChild("HasBall")
            if hb and hb:IsA("BoolValue") then
                if hasBallValue ~= hb then
                    hasBallValue = hb
                    hasBallValue:GetPropertyChangedSignal("Value"):Connect(function()
                        hasBallCache = hasBallValue.Value
                    end)
                end
                hasBallCache = hb.Value
                return
            end
        end
    end
    -- Fallback: verifica distância (menos confiável)
    if hitbox and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hasBallCache = (hrp.Position - hitbox.Position).Magnitude < 2.5
            return
        end
    end
    hasBallCache = false
end

atualizarHasBall()

-- Fallback: atualiza a cada frame para garantir
RunService.Heartbeat:Connect(atualizarHasBall)

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local velocidadeBola = 65
local isControlActive = false
local controlConnection = nil
local controlScreenGui = nil
local toggleButton = nil

local connectionAimbot = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  AIMBOT PERSONAGEM (LÓGICA DO CÓDIGO FORNECIDO)
-- =====================================================
local function updateView()
    -- Só executa se aimbotPersonagem estiver ativo, não tiver bola, e tiver referência válida
    if not aimbotPersonagem then return end
    if hasBallCache then return end  -- se estiver com a bola, não gira
    if not player.Character or not target then return end

    local character = player.Character
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")

    if rootPart and humanoid then
        -- Usa a posição da hitbox (se existir) ou da própria bola
        local posAlvo = hitbox and hitbox.Position or target.Position
        local targetPosition = Vector3.new(posAlvo.X, rootPart.Position.Y, posAlvo.Z)
        local direction = (targetPosition - rootPart.Position).Unit
        rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + direction)
        
        -- Câmera também segue (se aimbotCamera estiver ativo, usamos a lógica separada)
        -- Aqui a câmera é opcional, mas mantemos a do código fornecido como fallback
        if not aimbotCamera then
            camera.CFrame = CFrame.new(
                rootPart.Position - direction * 10 + Vector3.new(0, 5, 0), 
                rootPart.Position
            )
        end
    end
end

local function toggleAimbotPersonagem(estado)
    aimbotPersonagem = estado
    
    if estado then
        if connectionAimbot then connectionAimbot:Disconnect() end
        connectionAimbot = RunService.RenderStepped:Connect(updateView)
    else
        if connectionAimbot then
            connectionAimbot:Disconnect()
            connectionAimbot = nil
        end
    end
end

-- =====================================================
--  AIMBOT CÂMERA (SEPARADO)
-- =====================================================
local function atualizarAimbotCamera()
    if isControlActive then return end
    if not aimbotCamera or hasBallCache or not bolaValida or not hitbox then return end
    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then return end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  CONTROLE DA HITBOX (UNIFICADO)
-- =====================================================
local function aplicarTamanhoHitbox()
    if not hitbox then return end

    local tenho = hasBallCache
    local tamanhoDesejado
    local transparenciaDesejada

    if tenho or not reachAtivo then
        tamanhoDesejado = hitboxOriginalSize
        transparenciaDesejada = hitboxOriginalTransparency
    else
        tamanhoDesejado = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
        transparenciaDesejada = 1
    end

    if hitbox.Size ~= tamanhoDesejado or hitbox.Transparency ~= transparenciaDesejada then
        hitbox.Size = tamanhoDesejado
        hitbox.Transparency = transparenciaDesejada
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        aplicarTamanhoHitbox()
    end
end)

-- =====================================================
--  CONTROLE BOLA – BOTÃO FLUTUANTE
-- =====================================================
local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    isControlActive = not isControlActive
    
    if isControlActive then
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        
        if controlConnection then controlConnection:Disconnect() end
        
        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball then
                camera.CameraSubject = ball
                local lookVector = camera.CFrame.LookVector
                ball.AssemblyLinearVelocity = lookVector * velocidadeBola
            else
                resetCamera()
            end
        end)
    else
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        
        resetCamera()
    end
end

local function safeParent(gui)
    local ok = pcall(function()
        if gethui then
            gui.Parent = gethui()
        elseif syn and syn.protect_gui then
            syn.protect_gui(gui)
            gui.Parent = CoreGui
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then
        gui.Parent = player:WaitForChild("PlayerGui")
    end
end

local function criarBotaoFlutuante()
    if controlScreenGui then return end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGui"
    screenGui.ResetOnSpawn = false
    safeParent(screenGui)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    btn.Text = "Control BALL [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn

    btn.MouseButton1Click:Connect(toggleControl)

    toggleButton = btn
    controlScreenGui = screenGui
end

local function removerBotaoFlutuante()
    if isControlActive then
        toggleControl()
    end
    if controlScreenGui then
        controlScreenGui:Destroy()
        controlScreenGui = nil
        toggleButton = nil
    end
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if hasBallCache or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
RunService.Heartbeat:Connect(function()
    atualizarAimbotCamera()
    atualizarESP()
    -- O aimbot personagem é atualizado pelo connectionAimbot via RenderStepped
end)

