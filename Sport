--[[
    Blue Lock Rivels Hub – Com Controle de Bola
    - Botão flutuante "Control Ball v1" (Vermelho/Verde)
    - Controla a bola com a câmera (para onde olhar)
    - Desativa aimbots automaticamente
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")
local userInputService = game:GetService("UserInputService")
local starterGui = game:GetService("StarterGui")

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = bola
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)

for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end

atualizarReferenciaBola()

-- =====================================================
--  POSSE
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false
local controleBolaAtivo = false

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  VARIÁVEIS DO CONTROLE DE BOLA
-- =====================================================
local velocidadeBola = 20  -- padrão
local bolaBodyVelocity = nil
local bolaBodyGyro = nil

-- =====================================================
--  RESET DA HITBOX
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  CONTROLE DE BOLA
-- =====================================================
local function ativarControleBola(estado)
    controleBolaAtivo = estado
    
    if estado then
        -- Desativa aimbots
        if aimbotPersonagem then
            ativarAimbotPersonagem(false)
        end
        aimbotCamera = false
        
        -- Cria BodyVelocity e BodyGyro na bola
        if hitbox then
            -- Remove qualquer BodyVelocity antigo
            for _, child in ipairs(hitbox:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("BodyGyro") then
                    child:Destroy()
                end
            end
            
            bolaBodyVelocity = Instance.new("BodyVelocity")
            bolaBodyVelocity.Parent = hitbox
            bolaBodyVelocity.MaxForce = Vector3.new(10000, 10000, 10000)
            bolaBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            
            bolaBodyGyro = Instance.new("BodyGyro")
            bolaBodyGyro.Parent = hitbox
            bolaBodyGyro.D = 5000
            bolaBodyGyro.P = 10000
            bolaBodyGyro.MaxTorque = Vector3.new(8000, 8000, 8000)
        end
        
        -- Notificação
        starterGui:SetCore("SendNotification",{
            Title = "Controle de Bola",
            Text = "Ativado! Use a câmera para controlar a bola.",
            Duration = 2
        })
        
    else
        -- Remove controles da bola
        if hitbox then
            for _, child in ipairs(hitbox:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("BodyGyro") then
                    child:Destroy()
                end
            end
        end
        bolaBodyVelocity = nil
        bolaBodyGyro = nil
        
        -- Volta câmera para o personagem
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                camera.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 2, 10), hrp.Position)
            end
        end
        
        -- Reativa aimbots se estavam ativos (opcional)
        -- O usuário pode reativar manualmente
        
        starterGui:SetCore("SendNotification",{
            Title = "Controle de Bola",
            Text = "Desativado!",
            Duration = 2
        })
    end
end

local function atualizarControleBola()
    if not controleBolaAtivo then return end
    if not hitbox then return end
    
    -- Câmera segue a bola
    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, 0.1)
    camera.CFrame = CFrame.new(novaPos, posBola)
    
    -- Controla a direção da bola com base na câmera
    local lookVector = camera.CFrame.LookVector
    local velocidade = velocidadeBola
    
    -- Aplica velocidade na direção que a câmera está olhando
    if bolaBodyVelocity then
        bolaBodyVelocity.Velocity = lookVector * velocidade
    end
    
    -- Mantém a bola alinhada com a câmera (opcional)
    if bolaBodyGyro then
        bolaBodyGyro.CFrame = CFrame.lookAt(hitbox.Position, hitbox.Position + lookVector)
    end
end

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    if controleBolaAtivo then
        -- Se controle de bola estiver ativo, não permite ativar aimbot
        if estado then
            starterGui:SetCore("SendNotification",{
                Title = "Aimbot",
                Text = "Desative o Controle de Bola primeiro!",
                Duration = 2
            })
            return
        end
    end
    
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if controleBolaAtivo then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end
    
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if controleBolaAtivo then return end
    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH
-- =====================================================
-- (já está sendo gerenciado pelo reset loop)

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarControleBola()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
end)

-- =====================================================
--  BOTÃO FLUTUANTE (Control Ball v1)
-- =====================================================
local function criarBotaoFlutuante()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGUI"
    screenGui.Parent = player.PlayerGui
    screenGui.ResetOnSpawn = false
    
    local button = Instance.new("ImageButton")
    button.Name = "ControlBallButton"
    button.Parent = screenGui
    button.Size = UDim2.new(0, 120, 0, 40)
    button.Position = UDim2.new(0.85, 0, 0.5, 0)
    button.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho (desligado)
    button.BackgroundTransparency = 0.2
    button.BorderSizePixel = 2
    button.BorderColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = "Control Ball v1"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 14
    button.Font = Enum.Font.SourceSansBold
    
    -- Permite arrastar o botão
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    userInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            button.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    -- Alterna o estado ao clicar
    button.MouseButton1Click:Connect(function()
        local novoEstado = not controleBolaAtivo
        ativarControleBola(novoEstado)
        
        if novoEstado then
            button.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Verde (ligado)
            button.Text = "Control Ball v1 [ON]"
        else
            button.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho (desligado)
            button.Text = "Control Ball v1"
        end
    end)
    
    return button
end

-- Criar o botão
local botaoFlutuante = criarBotaoFlutuante()

-- =====================================================
--  CHAT: Velocidade da Bola
-- =====================================================
local function configurarVelocidadeBola()
    local chat = game:GetService("Chat")
    
    -- Cria um comando de chat para ajustar a velocidade
    local function onPlayerChatted(player, message)
        if player ~= player then return end
        
        if message:lower():match("^velocidade") then
            local num = tonumber(message:match("%d+"))
            if num and num > 0 and num <= 100 then
                velocidadeBola = num
                starterGui:SetCore("SendNotification",{
                    Title = "Velocidade da Bola",
                    Text = "Agora é: " .. num,
                    Duration = 2
                })
            else
                starterGui:SetCore("SendNotification",{
                    Title = "Velocidade da Bola",
                    Text = "Use: /velocidade [1-100]",
                    Duration = 2
                })
            end
        end
    end
    
    chat.Chatted:Connect(onPlayerChatted)
end

configurarVelocidadeBola()

