--  CATEGORIA 2: Blue Lock Rivels (Principal)
-- =====================================================
local MainTab = Window:Tab({ Title = "Blue Lock Rivels", Icon = "home" })

local secAimbot = MainTab:Section({ Title = "Aimbot", TextXAlignment = "Left" })

secAimbot:Toggle({
    Title = "Aimbot Personagem (Grudado)",
    Desc = "Corpo vira para a bola – só desativa se VOCÊ tiver",
    Callback = function(v)
        ativarAimbotPersonagem(v)
    end
})

secAimbot:Toggle({
    Title = "Aimbot Câmera (Rápida)",
    Desc = "Câmera segue a bola – não desativa em chutes",
    Callback = function(v)
        aimbotCamera = v
    end
})

local secReach = MainTab:Section({ Title = "Reach (Magnet)", TextXAlignment = "Left" })

secReach:Slider({
    Title = "Alcance",
    Desc = "Distância para pegar a bola",
    Step = 1,
    Value = { Min = 1, Max = 40, Default = 20 },
    Callback = function(v)
        reachDistancia = v
        if espSphere then
            espSphere.Scale = Vector3.new(v / 2.5, v / 2.5, v / 2.5)
        end
    end
})

secReach:Toggle({
    Title = "Ativar Reach",
    Desc = "Aumenta a hitbox (invisível)",
    Callback = function(v)
        reachAtivo = v
    end
})

secReach:Toggle({
    Title = "Mostrar Área (ESP)",
    Desc = "Círculo verde em volta da bola (`BallAnims`)",
    Callback = function(v)
        mostrarESP = v
        if not v and espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
    end
