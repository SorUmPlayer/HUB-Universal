local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local isActive = false
local controlConnection = nil

-- Criando a Interface do Botão Voador (Design limpo e arrastável)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ControlBallGui"
screenGui.ResetOnSpawn = false

-- Tenta colocar no CoreGui para proteger o script, se falhar vai pro PlayerGui
local success, _ = pcall(function() screenGui.Parent = CoreGui end)
if not success then screenGui.Parent = player:WaitForChild("PlayerGui") end

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 180, 0, 45)
toggleButton.Position = UDim2.new(0.5, -90, 0.1, 0)
toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69) -- Vermelho (Desligado)
toggleButton.Text = "Control BALL [OFF]"
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.Font = Enum.Font.GothamBold
toggleButton.TextSize = 16
toggleButton.Active = true
toggleButton.Draggable = true -- Permite arrastar o botão livremente pela tela
toggleButton.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = toggleButton

-- Função para encontrar a bola dinamicamente (evita erros se a bola sumir/resetar)
local function getBall()
    local football = Workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            -- Retorna o próprio objeto se for uma BasePart, ou procura a parte principal dentro dele
            if ballAnims:IsA("BasePart") then 
                return ballAnims 
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

-- Lógica de Controle
local function toggleControl()
    isActive = not isActive
    
    if isActive then
        -- Estado Ligado (Verde)
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        toggleButton.Text = "Control BALL [ON]"
        
        controlConnection = RunService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball then
                -- Força a câmera para a bola em 3ª pessoa
                camera.CameraSubject = ball
                
                -- Faz a bola se mover na direção da sua câmera
                local lookVector = camera.CFrame.LookVector
                
                -- Controla o movimento usando a física do jogo (Velocidade = 65)
                ball.AssemblyLinearVelocity = lookVector * 65 
            else
                -- Se a bola sumir momentaneamente, volta a câmera para o jogador
                if player.Character and player.Character:FindFirstChild("Humanoid") then
                    camera.CameraSubject = player.Character.Humanoid
                end
            end
        end)
    else
        -- Estado Desligado (Vermelho)
        toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
        toggleButton.Text = "Control BALL [OFF]"
        
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        
        -- Restaura a câmera para o personagem
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            camera.CameraSubject = player.Character.Humanoid
        end
    end
end

toggleButton.MouseButton1Click:Connect(toggleControl)
