--[[
    Blue Lock Rivels Hub – Definitivo
    - Integração exata do ControlBALL com busca em Workspace.Football.BallAnims
    - Alternância de câmera para a bola + AssemblyLinearVelocity via camera.CFrame.LookVector
    - Botão flutuante arrastável com estado Verde (ON) / Vermelho (OFF)
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")
local coreGui = game:GetService("CoreGui")

-- =====================================================
--  REFERÊNCIAS DA BOLA PARA AIMBOT / REACH
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                hitbox = (hb and hb:IsA("BasePart")) and hb or bola
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            hitbox = (hb and hb:IsA("BasePart")) and hb or bola
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)

for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end

atualizarReferenciaBola()

-- =====================================================
--  FUNÇÃO GETBALL (SUA LÓGICA EXATA DE BUSCA)
-- =====================================================
local function getBall()
    local football = workspace:FindFirstChild("Football")
    if football then
        local ballAnims = football:FindFirstChild("BallAnims")
        if ballAnims then
            if ballAnims:IsA("BasePart") then 
                return ballAnims 
            end
            return ballAnims:FindFirstChildWhichIsA("BasePart") or ballAnims.PrimaryPart
        end
    end
    return nil
end

-- =====================================================
--  POSSE DA BOLA
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local velocidadeBola = 65
local isControlActive = false
local controlConnection = nil
local controlScreenGui = nil
local toggleButton = nil

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  SISTEMA DO BOTÃO FLUTUANTE (CONTROLBALL)
-- =====================================================
local function resetCamera()
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        camera.CameraSubject = player.Character.Humanoid
    end
end

local function toggleControl()
    isControlActive = not isControlActive
    
    if isControlActive then
        -- Estado Ligado (Verde)
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"
        end
        
        if controlConnection then controlConnection:Disconnect() end
        
        controlConnection = runService.Heartbeat:Connect(function()
            local ball = getBall()
            if ball then
                camera.CameraSubject = ball
                local lookVector = camera.CFrame.LookVector
                ball.AssemblyLinearVelocity = lookVector * velocidadeBola
            else
                resetCamera()
            end
        end)
    else
        -- Estado Desligado (Vermelho)
        if toggleButton then
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"
        end
        
        if controlConnection then
            controlConnection:Disconnect()
            controlConnection = nil
        end
        
        resetCamera()
    end
end

local function criarBotaoFlutuante()
    if controlScreenGui then return end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGui"
    screenGui.ResetOnSpawn = false

    local parentObj = (gethui and gethui()) or (syn and syn.protect_gui and (syn.protect_gui(screenGui), coreGui)) or coreGui
    screenGui.Parent = parentObj

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 45)
    btn.Position = UDim2.new(0.5, -90, 0.1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    btn.Text = "Control BALL [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Active = true
    btn.Draggable = true
    btn.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = btn

    btn.MouseButton1Click:Connect(toggleControl)

    toggleButton = btn
    controlScreenGui = screenGui
end

local function removerBotaoFlutuante()
    if isControlActive then
        toggleControl()
    end
    if controlScreenGui then
        controlScreenGui:Destroy()
        controlScreenGui = nil
        toggleButton = nil
    end
end

-- =====================================================
--  RESET DA HITBOX (a cada 0.3s)
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem or euTenhoBola() or not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if isControlActive then return end -- Dá prioridade total ao ControlBALL quando ativo
    if not aimbotCamera or euTenhoBola() or not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then return end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
end)

