local secExtras = MainTab:Section({ Title = "Extras", TextXAlignment = "Left" })

secExtras:Button({
    Title = "Infinite Stamina",
    Desc = "Stamina infinita",
    Callback = function()
        task.spawn(function()
            while true do
                local player = game:GetService("Players").LocalPlayer
                if player:FindFirstChild("PlayerStats") and player.PlayerStats:FindFirstChild("Stamina") then
                    player.PlayerStats.Stamina.Value = 100
                end
                task.wait()
            end
        end)
    end
})

secExtras:Dropdown({
    Title = "Time",
    Desc = "Selecione para o gol",
    Options = {"Home", "Away"},
    Callback = function(opt)
        selectedTeam = opt
    end
})

secExtras:Button({
    Title = "Fazer Gol",
    Desc = "Marca um gol",
    Callback = function()
        if not selectedTeam then
            warn("Selecione um time primeiro!")
            return
        end

        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local posOriginal = hrp.Position
        local posGol = selectedTeam == "Home" and Vector3.new(-234, 11, -47) or Vector3.new(311, 11, -50)

        hrp.CFrame = CFrame.new(posGol)
        task.wait(0.2)
        local args = { [1] = 110, [4] = posGol }
        game:GetService("ReplicatedStorage").Packages.Knit.Services.BallService.RE.Shoot:FireServer(unpack(args))
        task.wait(0.2)
        hrp.CFrame = CFrame.new(posOriginal)
    end
})

