    Blue Lock Rivels Hub – Com Controle de Bola (corrigido)
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

-- =====================================================
--  ATUALIZA REFERÊNCIA DA BOLA (EVENTOS)
-- =====================================================
local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = bola
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)

for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end

atualizarReferenciaBola()

-- =====================================================
--  POSSE – APENAS POR Workspace.SeuNome.Football
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  CONTROLE DE BOLA (Botão Flutuante)
-- =====================================================
local controlButtonActive = false
local controlConnection = nil
local bolaSpeed = 65
local screenGui = nil
local toggleButton = nil
local isControlActive = false

-- Função para encontrar a bola (usa o cache)
local function getBallForControl()
    if bola and bolaValida then
        return bola
    end
    return nil
end

-- =====================================================
--  RESET DA HITBOX
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
end)

-- =====================================================
--  CONTROLE DE BOLA – BOTÃO FLUTUANTE (CORRIGIDO)
-- =====================================================
local function criarBotaoFlutuante()
    -- Se já existir, não cria outro
    if screenGui then return end

    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGui"
    screenGui.ResetOnSpawn = false

    local success, err = pcall(function()
        screenGui.Parent = CoreGui
    end)
    if not success then
        screenGui.Parent = player:WaitForChild("PlayerGui")
    end

    toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 180, 0, 45)
    toggleButton.Position = UDim2.new(0.5, -90, 0.1, 0)
    toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    toggleButton.Text = "Control BALL [OFF]"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.TextSize = 16
    toggleButton.Active = true
    toggleButton.Draggable = true
    toggleButton.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = toggleButton

    -- Lógica do botão
    isControlActive = false

    local function toggleControl()
        isControlActive = not isControlActive

        if isControlActive then
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
            toggleButton.Text = "Control BALL [ON]"

            if controlConnection then
                controlConnection:Disconnect()
            end

            controlConnection = RunService.Heartbeat:Connect(function()
                local ball = getBallForControl()
                if ball and bolaValida then
                    -- Força a câmera para a bola
                    camera.CameraSubject = ball

                    -- Move a bola na direção da câmera
                    local lookVector = camera.CFrame.LookVector
                    ball.AssemblyLinearVelocity = lookVector * bolaSpeed
                else
                    -- Se a bola sumir, volta a câmera para o jogador
                    if player.Character and player.Character:FindFirstChild("Humanoid") then
                        camera.CameraSubject = player.Character.Humanoid
                    end
                end
            end)
        else
            toggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
            toggleButton.Text = "Control BALL [OFF]"

            if controlConnection then
                controlConnection:Disconnect()
                controlConnection = nil
            end

            -- Restaura a câmera para o personagem
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                camera.CameraSubject = player.Character.Humanoid
            end
        end
    end

    toggleButton.MouseButton1Click:Connect(toggleControl)
end

local function destruirBotaoFlutuante()
    if screenGui then
        screenGui:Destroy()
        screenGui = nil
        toggleButton = nil
    end
    if controlConnection then
        controlConnection:Disconnect()
        controlConnection = nil
    end
    isControlActive = false
end

-- =====================================================
--  CHAT – ESCRAVA VELOCIDADE DA BOLA
-- =====================================================
local function escravaVelocidade(args)
    local speed = tonumber(args)
    if speed and speed > 0 and speed < 200 then
        bolaSpeed = speed
        player:Chat("Velocidade da bola alterada para " .. speed)
    else
        player:Chat("Velocidade inválida! Use um número entre 1 e 199.")
    end
end

local function configurarChatCommand()
    local function onChatMessage(msg)
        if msg:lower():match("^escrava velocidade da bola") then
            local speedStr = msg:match("^escrava velocidade da bola (.+)")
            if speedStr then
                escravaVelocidade(speedStr)
            end
        end
    end

    local chatService = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    if chatService then
        local onMessage = chatService:FindFirstChild("OnMessage")
        if onMessage then
            onMessage.OnClientEvent:Connect(onChatMessage)
        end
    else
        game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
            Text = "Digite 'Escrava velocidade da bola [número]' no chat!"
        })
    end
end

configurarChatCommand()

