-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = child:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = child
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end
atualizarReferenciaBola()

-- =====================================================
--  POSSE (exclusiva por Workspace)
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

-- Controle de Bola
local controlBallActive = false
local ballSpeed = 20
local controlBallBodyVelocity = nil
local aimbotPersonagemAntes = false
local aimbotCameraAntes = false

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  RESET DA HITBOX
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if controlBallActive then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if controlBallActive then return end
    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  CONTROLE DE BOLA
-- =====================================================
local function toggleControlBall()
    controlBallActive = not controlBallActive

    if controlBallActive then
        -- Salva estados atuais dos aimbots
        aimbotPersonagemAntes = aimbotPersonagem
        aimbotCameraAntes = aimbotCamera

        -- Desativa aimbots
        if aimbotPersonagem then ativarAimbotPersonagem(false) end
        if aimbotCamera then aimbotCamera = false end

        -- Cria BodyVelocity na bola
        if hitbox then
            controlBallBodyVelocity = Instance.new("BodyVelocity")
            controlBallBodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
            controlBallBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            controlBallBodyVelocity.Parent = hitbox
        end
    else
        -- Remove BodyVelocity
        if controlBallBodyVelocity then
            controlBallBodyVelocity:Destroy()
            controlBallBodyVelocity = nil
        end

        -- Restaura aimbots (se estavam ativos antes)
        if aimbotPersonagemAntes then
            ativarAimbotPersonagem(true)
            aimbotPersonagemAntes = false
        end
        if aimbotCameraAntes then
            aimbotCamera = true
            aimbotCameraAntes = false
        end
    end
end

-- Loop do controle de bola (executa a cada frame)
runService.Heartbeat:Connect(function()
    if not controlBallActive then return end
    if not hitbox then return end

    -- 1) Atualiza velocidade da bola baseado na direção da câmera
    local cameraDirection = camera.CFrame.LookVector
    local velocidade = cameraDirection * ballSpeed

    if controlBallBodyVelocity then
        controlBallBodyVelocity.Velocity = velocidade
    end

    -- 2) Mantém a câmera focada na bola (terceira pessoa)
    local posBola = hitbox.Position
    local offset = camera.CFrame.RightVector * -8 + Vector3.new(0, 4, 0)  -- atrás e acima
    local novaPosCam = posBola + offset
    camera.CFrame = CFrame.new(novaPosCam, posBola)
end)

-- =====================================================
--  ESP (verde)
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
end)

