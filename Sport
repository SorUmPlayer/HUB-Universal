--[[
    Blue Lock Rivels Hub – Versão Estável
    - FPS otimizado (sem lag)
    - Aimbot preciso (corpo e câmera)
    - Funciona com ShiftLock (opção para desativar)
    - Stamina infinita funcionando
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")
local userInput = game:GetService("UserInputService")

-- =====================================================
--  DETECÇÃO DA BOLA
-- =====================================================
local function getBall()
    local football = workspace:FindFirstChild("Football")
    if football then return football end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("ball") then
            return obj
        end
    end
    return nil
end

local function getHitbox()
    local ball = getBall()
    if ball then
        if ball.Name == "Hitbox" then return ball end
        local hitbox = ball:FindFirstChild("Hitbox")
        if hitbox and hitbox:IsA("BasePart") then return hitbox end
        return ball
    end
    return nil
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false
local desativarShiftLock = false

local gyro = nil
local cameraSmooth = 0.15
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- Cache de posse
local hasBallCache = false
local hasBallValue = nil

-- =====================================================
--  FUNÇÃO DE POSSE (com evento)
-- =====================================================
local function atualizarCachePosse()
    local model = workspace:FindFirstChild(player.Name)
    if model then
        local values = model:FindFirstChild("Values")
        if values then
            local hb = values:FindFirstChild("HasBall")
            if hb and hb:IsA("BoolValue") then
                if hasBallValue ~= hb then
                    hasBallValue = hb
                    hasBallValue:GetPropertyChangedSignal("Value"):Connect(function()
                        hasBallCache = hasBallValue.Value
                    end)
                end
                hasBallCache = hb.Value
                return
            end
        end
    end
    -- Fallback: verifica distância (apenas uma vez para cache)
    local hitbox = getHitbox()
    if not hitbox then 
        hasBallCache = false
        return 
    end
    local char = player.Character
    if not char then 
        hasBallCache = false
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        hasBallCache = false
        return 
    end
    hasBallCache = (hrp.Position - hitbox.Position).Magnitude < 2.5
end

atualizarCachePosse()

-- =====================================================
--  RESTAURA HITBOX
-- =====================================================
local function restaurarHitbox()
    local hitbox = getHitbox()
    if hitbox then
        hitbox.Size = hitboxOriginalSize
        hitbox.Transparency = hitboxOriginalTransparency
    end
end

-- =====================================================
--  AIMBOT PERSONAGEM (BodyGyro)
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if not aimbotPersonagem then 
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return 
    end
    
    if hasBallCache then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end
    
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local hitbox = getHitbox()
    if not hitbox then return end

    -- Desativa ShiftLock se ativado
    if desativarShiftLock and userInput:GetFocused() then
        -- Simula pressionar Shift para desativar (se o jogo usar)
        -- Ou simplesmente ignoramos, pois BodyGyro força a rotação
    end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 500
        gyro.P = 5000
        gyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if not aimbotCamera then return end
    if hasBallCache then return end
    
    local hitbox = getHitbox()
    if not hitbox then return end
    
    -- Não força câmera durante chute
    if hitbox.AssemblyLinearVelocity.Magnitude > 50 then
        return
    end
    
    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    if (posCamera - posBola).Magnitude > 100 then return end
    
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  REACH
-- =====================================================
local reachAplicado = false

local function aplicarReach()
    if hasBallCache or not reachAtivo then
        if reachAplicado then
            restaurarHitbox()
            reachAplicado = false
        end
        return
    end
    
    local hitbox = getHitbox()
    if not hitbox then return end
    
    local novoSize = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
    if hitbox.Size ~= novoSize then
        hitbox.Size = novoSize
        hitbox.Transparency = 0.5
        reachAplicado = true
    end
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if hasBallCache or not mostrarESP then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end
    
    local hitbox = getHitbox()
    if not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end
    
    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 100)
        espSphere.Transparency = 0.7
    end
    
    local scale = reachDistancia / 2
    if espSphere.Scale.X ~= scale then
        espSphere.Scale = Vector3.new(scale, scale, scale)
    end
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    aplicarReach()
    atualizarESP()
end)

-- =====================================================
--  INFINITE STAMINA
-- =====================================================
task.spawn(function()
    while true do
        local stats = player:FindFirstChild("PlayerStats")
        if stats then
            local stamina = stats:FindFirstChild("Stamina")
            if stamina and stamina:IsA("NumberValue") then
                stamina.Value = 100
            end
        end
        task.wait(0.3)
    end
end)

