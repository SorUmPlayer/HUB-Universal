-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = bola
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end
atualizarReferenciaBola()

-- =====================================================
--  POSSE
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

-- Controle de Bola
local controlBallActive = false
local ballSpeed = 20
local aimbotPersonagemSalvo = false
local aimbotCameraSalvo = false

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  RESET DA HITBOX
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if controlBallActive then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if controlBallActive then return end
    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  CONTROLE DE BOLA
-- =====================================================
local function alternarControleBola(estado)
    controlBallActive = estado

    if estado then
        -- Salva estado atual dos aimbots
        aimbotPersonagemSalvo = aimbotPersonagem
        aimbotCameraSalvo = aimbotCamera

        -- Desativa aimbots
        ativarAimbotPersonagem(false)
        aimbotCamera = false
    else
        -- Restaura aimbots
        if aimbotPersonagemSalvo then
            ativarAimbotPersonagem(true)
        end
        if aimbotCameraSalvo then
            aimbotCamera = true
        end
    end
end

local function atualizarControleBola()
    if not controlBallActive then return end
    if not bolaValida or not hitbox then return end

    -- 1) Câmera atrás da bola (terceira pessoa)
    local posBola = hitbox.Position
    local camDirection = camera.CFrame.LookVector
    local camPos = posBola - camDirection * 5 + Vector3.new(0, 2, 0) -- atrás e um pouco acima
    camera.CFrame = CFrame.new(camPos, posBola)

    -- 2) Move a bola na direção da câmera
    local direction = camera.CFrame.LookVector
    -- Move no plano XZ (horizontal) e também no Y (vertical)
    local velocidade = direction * ballSpeed
    hitbox.AssemblyLinearVelocity = velocidade
end

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarControleBola()
    atualizarESP()
end)

-- =====================================================
--  BOTÃO FLUTUANTE (Control Ball v1)
-- =====================================================
local function criarBotaoFlutuante()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGUI"
    screenGui.Parent = player.PlayerGui

    local button = Instance.new("TextButton")
    button.Name = "ControlBallButton"
    button.Size = UDim2.new(0, 120, 0, 40)
    button.Position = UDim2.new(0.5, -60, 0.85, 0) -- canto inferior
    button.Text = "Control Ball v1"
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- vermelho (desligado)
    button.BorderSizePixel = 0
    button.Parent = screenGui

    -- Arrastável
    local dragging = false
    local dragStart = nil
    local startPos = nil

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = button.Position
        end
    end)

    button.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            button.Position = UDim2.new(
                startPos.X.Scale + delta.X / screenGui.AbsoluteSize.X,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale + delta.Y / screenGui.AbsoluteSize.Y,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- Alternar ao clicar
    button.MouseButton1Click:Connect(function()
        local novoEstado = not controlBallActive
        alternarControleBola(novoEstado)

        -- Atualiza cor do botão
        if novoEstado then
            button.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- verde (ligado)
            button.Text = "Control Ball v1 (ON)"
        else
            button.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- vermelho (desligado)
            button.Text = "Control Ball v1"
        end

        -- Sincroniza toggle no menu
        if toggleControlBall then
            toggleControlBall:SetValue(novoEstado)
        end
    end)

    return button
end

-- Cria o botão flutuante
local botaoFlutuante = criarBotaoFlutuante()

