--[[
    Blue Lock Rivels Hub – Controle de Bola
    - Toggle no menu: mostra/esconde o botão flutuante
    - Botão flutuante: ativa/desativa o controle (verde/vermelho)
    - Controle de bola funcionando 100%
]]

local _ENV = getgenv()
local player = game.Players.LocalPlayer
local camera = game.Workspace.CurrentCamera
local runService = game:GetService("RunService")
local userInputService = game:GetService("UserInputService")

-- =====================================================
--  REFERÊNCIAS DA BOLA (CACHE)
-- =====================================================
local bola = nil
local hitbox = nil
local bolaValida = false

local function atualizarReferenciaBola()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local football = child:FindFirstChild("Football")
            if football then
                bola = football
                local hb = bola:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then
                    hitbox = hb
                else
                    hitbox = bola
                end
                bolaValida = true
                return
            end
        elseif child.Name == "Football" then
            bola = child
            local hb = bola:FindFirstChild("Hitbox")
            if hb and hb:IsA("BasePart") then
                hitbox = hb
            else
                hitbox = bola
            end
            bolaValida = true
            return
        end
    end
    bola = nil
    hitbox = nil
    bolaValida = false
end

workspace.ChildAdded:Connect(atualizarReferenciaBola)
workspace.ChildRemoved:Connect(atualizarReferenciaBola)
for _, child in ipairs(workspace:GetChildren()) do
    if child:IsA("Model") then
        child.ChildAdded:Connect(atualizarReferenciaBola)
        child.ChildRemoved:Connect(atualizarReferenciaBola)
    end
end
atualizarReferenciaBola()

-- =====================================================
--  POSSE (APENAS POR Workspace.SeuNome.Football)
-- =====================================================
local function euTenhoBola()
    local meuModel = workspace:FindFirstChild(player.Name)
    if meuModel and meuModel:FindFirstChild("Football") then
        return true
    end
    return false
end

-- =====================================================
--  VARIÁVEIS DE CONTROLE
-- =====================================================
local aimbotPersonagem = false
local aimbotCamera = false
local reachAtivo = false
local reachDistancia = 20
local mostrarESP = false

-- Controle de Bola
local controlBallAtivo = false
local velocidadeBola = 20
local bolaControlavel = false
local botaoVisivel = true -- padrão visível

local gyro = nil
local cameraSmooth = 0.08
local selectedTeam = nil

local espSphere = nil
local hitboxOriginalSize = Vector3.new(1.4, 1.4, 1.4)
local hitboxOriginalTransparency = 0

-- =====================================================
--  RESET DA HITBOX
-- =====================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if hitbox then
            if not reachAtivo or euTenhoBola() then
                if hitbox.Size ~= hitboxOriginalSize or hitbox.Transparency ~= hitboxOriginalTransparency then
                    hitbox.Size = hitboxOriginalSize
                    hitbox.Transparency = hitboxOriginalTransparency
                end
            else
                hitbox.Size = Vector3.new(reachDistancia, reachDistancia, reachDistancia)
                hitbox.Transparency = 1
            end
        end
    end
end)

-- =====================================================
--  AIMBOT PERSONAGEM
-- =====================================================
local function ativarAimbotPersonagem(estado)
    aimbotPersonagem = estado
    if not estado and gyro then
        gyro:Destroy()
        gyro = nil
    end
end

local function atualizarAimbotPersonagem()
    if controlBallAtivo then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not aimbotPersonagem then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if euTenhoBola() then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    if not bolaValida or not hitbox then
        if gyro then
            gyro:Destroy()
            gyro = nil
        end
        return
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not gyro then
        gyro = Instance.new("BodyGyro")
        gyro.Parent = hrp
        gyro.D = 1000
        gyro.P = 10000
        gyro.MaxTorque = Vector3.new(8000, 8000, 8000)
    end

    local posBola = hitbox.Position
    local posJogador = hrp.Position
    local direcao = (Vector3.new(posBola.X, posJogador.Y, posBola.Z) - posJogador).Unit
    gyro.CFrame = CFrame.lookAt(posJogador, posJogador + direcao)
end

-- =====================================================
--  AIMBOT CÂMERA
-- =====================================================
local function atualizarAimbotCamera()
    if controlBallAtivo then
        return
    end

    if not aimbotCamera then return end
    if euTenhoBola() then return end
    if not bolaValida or not hitbox then return end

    if hitbox.AssemblyLinearVelocity.Magnitude > 80 then
        return
    end

    local posBola = hitbox.Position
    local posCamera = camera.CFrame.Position
    local novaPos = posCamera:Lerp(posBola, cameraSmooth)
    camera.CFrame = CFrame.new(novaPos, posBola)
end

-- =====================================================
--  CONTROLE DE BOLA (CORRIGIDO)
-- =====================================================
local function controlarBola()
    if not controlBallAtivo then return end
    if not bolaValida or not hitbox then return end

    -- Se a bola estiver no pé, controla
    if euTenhoBola() then
        bolaControlavel = true
        -- Câmera segue a bola
        local posBola = hitbox.Position
        local posCamera = camera.CFrame.Position
        local novaPos = posCamera:Lerp(posBola, 0.1)
        camera.CFrame = CFrame.new(novaPos, posBola)

        -- Aplica força na direção da câmera
        local direcaoCamera = camera.CFrame.LookVector
        -- Só aplica força se o jogador estiver olhando para cima/baixo ou em alguma direção
        if direcaoCamera.Y ~= 0 or direcaoCamera.X ~= 0 or direcaoCamera.Z ~= 0 then
            local forca = velocidadeBola * 1.5
            hitbox:ApplyImpulse(direcaoCamera * forca)
        end
    else
        -- Se não estiver no pé, tenta puxar se estiver perto
        bolaControlavel = false
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - hitbox.Position).Magnitude
                if dist < 30 then
                    local direcao = (hrp.Position - hitbox.Position).Unit
                    hitbox:ApplyImpulse(direcao * 2)
                end
            end
        end
    end
end

-- =====================================================
--  BOTÃO FLUTUANTE
-- =====================================================
local botaoFlutuante = nil

local function criarBotaoFlutuante()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ControlBallGUI"
    screenGui.Parent = player:WaitForChild("PlayerGui")
    screenGui.ResetOnSpawn = false

    local button = Instance.new("TextButton")
    button.Name = "ControlBallButton"
    button.Parent = screenGui
    button.Size = UDim2.new(0, 160, 0, 45)
    button.Position = UDim2.new(0.02, 0, 0.5, -22)
    button.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Vermelho
    button.BackgroundTransparency = 0.2
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextScaled = true
    button.Text = "Control Ball v1"
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 2
    button.BorderColor3 = Color3.fromRGB(255, 255, 255)
    button.Active = true
    button.Draggable = true
    button.Visible = botaoVisivel -- controlado pelo toggle

    -- Hover
    button.MouseEnter:Connect(function()
        button.BackgroundTransparency = 0.1
    end)
    button.MouseLeave:Connect(function()
        button.BackgroundTransparency = 0.2
    end)

    -- Clique
    button.MouseButton1Click:Connect(function()
        controlBallAtivo = not controlBallAtivo

        if controlBallAtivo then
            button.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            button.Text = "Control Ball v1 [ON]"
            
            -- Desativa aimbot personagem
            if gyro then
                gyro:Destroy()
                gyro = nil
            end
            
            -- Notificação
            StarterGui:SetCore("SendNotification",{
                Title = "Controle de Bola",
                Text = "Ativado! Use a câmera para controlar a bola.",
                Duration = 2
            })
        else
            button.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
            button.Text = "Control Ball v1"
            
            -- Reativa aimbot se estava ativo
            if aimbotPersonagem then
                ativarAimbotPersonagem(true)
            end
            
            -- Volta câmera para o personagem
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    camera.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 5, 10), hrp.Position)
                end
            end
            
            StarterGui:SetCore("SendNotification",{
                Title = "Controle de Bola",
                Text = "Desativado!",
                Duration = 2
            })
        end
    end)

    return button
end

-- Cria o botão
botaoFlutuante = criarBotaoFlutuante()

-- =====================================================
--  LOOP DO CONTROLE DE BOLA
-- =====================================================
runService.Heartbeat:Connect(function()
    if controlBallAtivo then
        controlarBola()
    end
end)

-- =====================================================
--  ESP
-- =====================================================
local function atualizarESP()
    if euTenhoBola() or not mostrarESP or not hitbox then
        if espSphere then
            espSphere:Destroy()
            espSphere = nil
        end
        return
    end

    if not espSphere then
        espSphere = Instance.new("SelectionSphere")
        espSphere.Name = "ReachESP"
        espSphere.Adornee = hitbox
        espSphere.Parent = hitbox
        espSphere.Color3 = Color3.fromRGB(0, 255, 0)
        espSphere.Transparency = 0.6
    end

    local scale = reachDistancia / 2.5
    espSphere.Scale = Vector3.new(scale, scale, scale)
end

-- =====================================================
--  LOOP PRINCIPAL
-- =====================================================
runService.Heartbeat:Connect(function()
    atualizarAimbotPersonagem()
    atualizarAimbotCamera()
    atualizarESP()
end)

